  pl("nb", -760, -60, 0, 820, 380, "");
  pl("nb", 760, -60, 0, 820, 380, "");
  pl("fac ff", 0, -160, 0, 700, 160, "");
  pl("sign ff", 0, -165, 3, 380, 76, "", "<b>Nuvella<small>CAFFE</small></b>");
