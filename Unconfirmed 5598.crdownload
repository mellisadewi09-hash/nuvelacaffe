const ICON_CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17l9-10"/></svg>';
const ICON_PLUS_SM = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';

return { ICON_PLUS, ICON_CHECK, ICON_PLUS_SM };
};
__def["js/state/finance.js"] = function () {
/* =========================================================
   Catatan keuangan (hanya admin): pengeluaran manual + biaya member.
   Pemasukan dari pesanan dihitung otomatis dari data pesanan.
   - ORDERS_DB_URL kosong  → localStorage
   - ORDERS_DB_URL terisi  → Firebase Realtime Database (path "finance")
   ========================================================= */
const { ORDERS_DB_URL } = __req("js/config/constants.js");
const { load, save } = __req("js/utils/storage.js");

var KEY = "nuvella_finance";
var isRemote = !!ORDERS_DB_URL;

function url(id) { return ORDERS_DB_URL.replace(/\/+$/, "") + "/finance" + (id ? "/" + encodeURIComponent(id) : "") + ".json"; }
function send(method, u, body) {
  return fetch(u, { method: method, headers: { "Content-Type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) })
    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); });
}


/* Data awal keuangan Januari sampai Oktober (diisi sekali saja, supaya rekap bulanan tidak 0).
   Angka dalam rupiah. Ubah daftar ini kalau mau angka lain, lalu ganti SEED_KEY supaya terisi ulang. */
var SEED_KEY = "nuvella_finance_seed_v1";
var SEED_YEAR = 2026;
var SEED_IN  = [400000, 300000, 500000, 200000, 400000, 500000, 300000, 400000, 500000, 200000];
var SEED_OUT = [150000, 100000, 200000,  80000, 150000, 200000, 100000, 150000, 200000,  80000];
async function seedOnce() {
  if (load(SEED_KEY, false)) return;
  var have = {};
  if (isRemote) { var d = await send("GET", url()); if (d) Object.keys(d).forEach(function (k) { have[k] = 1; }); }
  else load(KEY, []).forEach(function (e) { have[e.id] = 1; });
  for (var m = 0; m < SEED_IN.length; m++) {
    var at = new Date(SEED_YEAR, m, 15, 12).getTime(), mm = String(m + 1).padStart(2, "0");
    var rows = [
      { id: "seed-" + SEED_YEAR + "-" + mm + "-in", type: "in", cat: "Penjualan", amount: SEED_IN[m], note: "Pemasukan bulanan", at: at },
      { id: "seed-" + SEED_YEAR + "-" + mm + "-out", type: "out", cat: "Belanja bahan", amount: SEED_OUT[m], note: "Belanja bahan bulanan", at: at }
    ];
    for (var i = 0; i < rows.length; i++) if (!have[rows[i].id]) await addFinance(rows[i]);
  }
  save(SEED_KEY, true);
}

/* entri: { id, type: "in" | "out", cat, amount, note, at } */
async function listFinance() {
  try { await seedOnce(); } catch (e) { /* data awal gagal, lanjut tampil data yang ada */ }
  var all;
  if (isRemote) { var d = await send("GET", url()); all = d ? Object.keys(d).map(function (k) { return d[k]; }) : []; }
  else all = load(KEY, []);
  return all.sort(function (a, b) { return b.at - a.at; });
}

async function addFinance(e) {
  e.id = e.id || "f" + Date.now() + Math.floor(Math.random() * 1000);
  e.at = e.at || Date.now();
  if (isRemote) { await send("PUT", url(e.id), e); return e; }
  var all = load(KEY, []); all.push(e); save(KEY, all);
  return e;
}

async function removeFinance(id) {
  if (isRemote) { await send("DELETE", url(id)); return; }
  save(KEY, load(KEY, []).filter(function (e) { return e.id !== id; }));
}

return { listFinance, addFinance, removeFinance };
};
__def["js/state/members.js"] = function () {
/* =========================================================
   Penyimpanan kartu member + pengaturan hadiah.
   - ORDERS_DB_URL kosong  → localStorage (hanya browser yang sama)
   - ORDERS_DB_URL terisi  → Firebase Realtime Database lewat REST (semua perangkat)
   Kunci member = nomor HP (format 08xxxxxxxxxx).
   ========================================================= */
const { MEMBER_DEFAULT_REWARD, MEMBER_EXPIRE_MONTHS, MEMBER_BUNGA, MEMBER_FIRST_REWARD, MEMBER_TARGET, MEMBER_TIERS, ORDERS_DB_URL } = __req("js/config/constants.js");
const { load, save } = __req("js/utils/storage.js");

var isRemote = !!ORDERS_DB_URL;
var KEY_MEMBERS = "nuvella_members";
var KEY_SETTINGS = "nuvella_member_settings";

function url(path) { return ORDERS_DB_URL.replace(/\/+$/, "") + "/" + path + ".json"; }
function send(method, u, body) {
  return fetch(u, { method: method, headers: { "Content-Type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) })
    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); });
}

/* "+62 857-5518-3802" / "6285755183802" → "085755183802" */
function normPhone(v) {
  var d = String(v || "").replace(/[^0-9]/g, "");
  if (d.indexOf("62") === 0) d = "0" + d.slice(2);
  return d;
}

/* Firebase membuang array kosong, jadi selalu lengkapi bentuk datanya */
function fix(m) {
  if (!m) return null;
  m.stampedOrders = m.stampedOrders || [];
  m.history = m.history || [];
  m.stamps = m.stamps || 0;
  m.cycles = m.cycles || 0;
  m.bunga = m.bunga || 0;
  m.cycleSpend = m.cycleSpend || 0;
  if (typeof m.lifetime !== "number") m.lifetime = m.cycles * MEMBER_TARGET + m.stamps; /* total stempel sepanjang masa, dasar level */
  return m;
}

async function getMember(phone) {
  if (isRemote) return fix(await send("GET", url("members/" + encodeURIComponent(phone))));
  return fix(load(KEY_MEMBERS, {})[phone] || null);
}

async function listMembers() {
  var map = isRemote ? (await send("GET", url("members"))) || {} : load(KEY_MEMBERS, {});
  return Object.keys(map).map(function (k) { return fix(map[k]); })
    .sort(function (a, b) { return b.createdAt - a.createdAt; });
}

async function saveMember(m) {
  if (isRemote) { await send("PUT", url("members/" + encodeURIComponent(m.phone)), m); return; }
  var all = load(KEY_MEMBERS, {});
  all[m.phone] = m;
  save(KEY_MEMBERS, all);
}

async function removeMember(phone) {
  if (isRemote) { await send("DELETE", url("members/" + encodeURIComponent(phone))); return; }
  var all = load(KEY_MEMBERS, {});
  delete all[phone];
  save(KEY_MEMBERS, all);
}

/* Pengaturan hadiah yang diatur admin */
function defaultSettings() {
  return {
    firstReward: { title: MEMBER_FIRST_REWARD.title, desc: MEMBER_FIRST_REWARD.desc },
    reward: { title: MEMBER_DEFAULT_REWARD.title, desc: MEMBER_DEFAULT_REWARD.desc },
    minPurchase: 0,
    bunga: { min: MEMBER_BUNGA.min, rate: MEMBER_BUNGA.rate, payout: MEMBER_BUNGA.payout },
    tiers: MEMBER_TIERS.map(function (t) { return { id: t.id, name: t.name, min: t.min, discount: t.discount }; }),
    updatedAt: 0
  };
}

async function getSettings() {
  var d = defaultSettings();
  var s = isRemote ? await send("GET", url("settings")) : load(KEY_SETTINGS, null);
  if (!s) return d;
  return {
    firstReward: Object.assign(d.firstReward, s.firstReward || {}),
    reward: Object.assign(d.reward, s.reward || {}),
    minPurchase: Number(s.minPurchase) || 0,
    bunga: {
      min: s.bunga && !isNaN(Number(s.bunga.min)) ? Number(s.bunga.min) : d.bunga.min,
      rate: s.bunga && !isNaN(Number(s.bunga.rate)) ? Number(s.bunga.rate) : d.bunga.rate,
      payout: s.bunga && !isNaN(Number(s.bunga.payout)) ? Number(s.bunga.payout) : d.bunga.payout
    },
    tiers: d.tiers.map(function (t, i) {
      var o = (s.tiers && (Array.isArray(s.tiers) ? s.tiers[i] : s.tiers[t.id])) || {};
      return { id: t.id, name: t.name, min: i === 0 ? 0 : (isNaN(Number(o.min)) || o.min === undefined ? t.min : Number(o.min)), discount: isNaN(Number(o.discount)) || o.discount === undefined ? t.discount : Number(o.discount) };
    }),
    updatedAt: s.updatedAt || 0
  };
}

async function saveSettings(s) {
  if (isRemote) { await send("PUT", url("settings"), s); return; }
  save(KEY_SETTINGS, s);
}

/* Hadiah yang sedang dikejar sebuah kartu: siklus pertama = hadiah pertama, sesudahnya = hadiah dari admin */
function currentReward(member, settings) {
  return (member && member.cycles > 0) ? settings.reward : settings.firstReward;
}

function makeRedeemCode() {
  var abc = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789", out = "RW-";
  for (var i = 0; i < 6; i++) out += abc.charAt(Math.floor(Math.random() * abc.length));
  return out;
}

/* ---------- Aturan stempel (dipakai halaman admin) ---------- */
function log(m, type, note) {
  m.history.push({ type: type, at: Date.now(), note: note || "" });
  if (m.history.length > 60) m.history = m.history.slice(-60);
}

/* Tambah 1 stempel. Hasil: "ok" | "inactive" | "expired" (hangus) | "full" (kartu penuh, tukar hadiah dulu) */
function giveStamp(m, settings, note) {
  if (!m.active) return "inactive";
  if (isExpired(m)) return "expired";
  if (m.redeem || m.stamps >= MEMBER_TARGET) return "full";
  m.stamps++;
  m.lifetime = (m.lifetime || 0) + 1;
  m.lastActiveAt = Date.now();
  log(m, "stamp", note);
  if (m.stamps >= MEMBER_TARGET) {
    var r = currentReward(m, settings);
    m.redeem = { code: makeRedeemCode(), title: r.title, desc: r.desc, at: Date.now() };
    log(m, "unlock", m.redeem.code);
  }
  return "ok";
}

/* Kurangi 1 stempel (koreksi salah input). Tidak bisa saat hadiah sudah terbuka. */
function takeStamp(m) {
  if (m.redeem || m.stamps <= 0) return false;
  m.stamps--;
  m.lifetime = Math.max(0, (m.lifetime || 0) - 1);
  log(m, "unstamp", "");
  return true;
}

/* Kasir mengonfirmasi kode: kartu kembali ke 0 untuk siklus berikutnya */
function confirmRedeem(m) {
  if (!m.redeem) return false;
  log(m, "redeem", m.redeem.code + " · " + m.redeem.title);
  m.redeem = null;
  m.stamps = 0;
  m.cycles++;
  return true;
}

/* ---------- Hangus & level member ---------- */
/* Terakhir aktif: aktivasi, stempel terakhir, atau pesanan terakhir */
function lastActive(m) { return m.lastActiveAt || m.activatedAt || m.createdAt || 0; }

/* Hangus = sudah aktif tetapi 5 bulan tanpa aktivitas */
function expiryDate(m) { var d = new Date(lastActive(m)); d.setMonth(d.getMonth() + MEMBER_EXPIRE_MONTHS); return d; }
function isExpired(m) { return !!(m && m.active && Date.now() > expiryDate(m).getTime()); }

/* Member yang berhak diskon: aktif dan belum hangus */
function isLive(m) { return !!(m && m.active && !isExpired(m)); }

/* Level sekarang berdasarkan total stempel sepanjang masa */
function tierOf(m, settings) {
  var tiers = settings.tiers, cur = tiers[0], i;
  for (i = 0; i < tiers.length; i++) if ((m.lifetime || 0) >= tiers[i].min) cur = tiers[i];
  return cur;
}
function nextTier(m, settings) {
  var tiers = settings.tiers, i;
  for (i = 0; i < tiers.length; i++) if ((m.lifetime || 0) < tiers[i].min) return tiers[i];
  return null;
}

/* Diskon (persen) untuk sebuah nomor HP, 0 jika bukan member aktif */
function discountFor(m, settings) { return isLive(m) ? tierOf(m, settings).discount : 0; }

/* Aktifkan / aktifkan ulang kartu. Hangus: stempel dan level kembali ke awal. */
function activate(m, renew) {
  var now = Date.now();
  if (renew) { m.stamps = 0; m.lifetime = 0; m.stampedOrders = m.stampedOrders || []; }
  m.active = true; m.activatedAt = now; m.lastActiveAt = now;
  log(m, renew ? "renew" : "activate", "");
}

/* ---------- Bunga member (tabungan) ---------- */
function bungaRate(m, settings) { return settings.bunga.rate; }

/* Catat belanja satu pesanan ke siklus berjalan (hanya jika memenuhi minimal) */
function addSpend(m, settings, total) {
  if (!isLive(m) || (total || 0) < settings.bunga.min) return;
  m.cycleSpend = (m.cycleSpend || 0) + total;
}

/* Dipanggil saat 15 stempel selesai: bunga = persen dari total belanja siklus. Hasil: rupiah yang masuk. */
function creditCycleBunga(m, settings, note) {
  var add = Math.floor((m.cycleSpend || 0) * settings.bunga.rate / 100);
  m.cycleSpend = 0;
  if (add <= 0) return 0;
  m.bunga = (m.bunga || 0) + add;
  log(m, "bunga", "+" + add + (note ? " · " + note : ""));
  return add;
}

/* Kasir memakai saldo bunga (semua atau sebagian). Hasil: jumlah yang dipotong */
function spendBunga(m, amount) {
  var use = Math.min(Math.max(0, Math.floor(amount)), m.bunga || 0);
  if (!use) return 0;
  m.bunga -= use;
  log(m, "bunga", "-" + use + " dipakai");
  return use;
}

