  { id: "butter-croissant", cat: "pastry", fx: "steam", name: "Butter Croissant", desc: "Mentega Prancis, renyah berlapis", price: 21000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Croissant_bread.jpg?width=400" },
  { id: "pain-au-chocolat", cat: "pastry", fx: "choco", name: "Pain au Chocolat", desc: "Croissant dengan dua batang cokelat", price: 16000,
