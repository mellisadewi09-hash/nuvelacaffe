  { id: "cappuccino", cat: "coffe", fx: "steam", name: "Cappuccino", desc: "Espresso dengan foam susu tebal", price: 18000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Latte_art_cappuccino.jpg?width=400" },

  { id: "matcha-latte", cat: "non-coffe", fx: "steam", name: "Matcha Latte", desc: "Matcha dan susu segar", price: 19000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Matcha_Latte.jpg?width=400" },
  { id: "strawberry-matcha", cat: "non-coffe", fx: "bubble", name: "Strawberry Matcha", desc: "Matcha di atas susu stroberi", price: 19000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Strawberry_milk_shake_(cropped).jpg?width=400" },
  { id: "orange-squash", cat: "non-coffe", fx: "bubble", name: "Orange Squash", desc: "Jeruk peras dan soda", price: 15000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Orange_juice_1_edit1.jpg?width=400" }
];


/* Menu tambahan agar setiap kategori berisi 6 menu.
   Foto: taruh file di folder foto/ dengan nama sesuai id (contoh foto/creme-brulee.jpg).
   Kalau belum ada, otomatis dipakai foto cadangan dari kategori yang sama. */
MENU.push(
  { id: "waffle-ice-cream", cat: "signature", fx: "steam", name: "Waffle Ice Cream", desc: "Waffle hangat, es krim vanila, saus cokelat", price: 28000, img: "" },
  { id: "creme-brulee", cat: "signature", fx: "sparkle", name: "Creme Brulee", desc: "Custard vanila dengan karamel renyah", price: 30000, img: "" },
  { id: "panna-cotta", cat: "signature", fx: "sparkle", name: "Panna Cotta Berry", desc: "Panna cotta lembut dengan saus berry", price: 28000, img: "" },

  { id: "new-york-cheesecake", cat: "cheesecake", fx: "sparkle", name: "New York Cheesecake", desc: "Klasik, padat, dan creamy", price: 25000, img: "" },
  { id: "strawberry-cheesecake", cat: "cheesecake", fx: "sparkle", name: "Strawberry Cheesecake", desc: "Cheesecake dengan saus stroberi segar", price: 25000, img: "" },
  { id: "blueberry-cheesecake", cat: "cheesecake", fx: "sparkle", name: "Blueberry Cheesecake", desc: "Cheesecake dengan saus blueberry", price: 25000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Blueberry_cheesecake.jpg?width=400" },

  { id: "choco-hazelnut-crepe", cat: "mille-crepe", fx: "sparkle", name: "Choco Hazelnut", desc: "Crepe tipis, krim cokelat, dan hazelnut", price: 16000, img: "" },
  { id: "matcha-crepe", cat: "mille-crepe", fx: "sparkle", name: "Matcha Cream", desc: "Crepe matcha dan krim lembut", price: 16000, img: "" },
  { id: "tiramisu-crepe", cat: "mille-crepe", fx: "sparkle", name: "Tiramisu Crepe", desc: "Krim mascarpone dan taburan kakao", price: 16000, img: "" },

  { id: "almond-croissant", cat: "pastry", fx: "steam", name: "Almond Croissant", desc: "Croissant isi krim almond, taburan almond", price: 22000, img: "" },
  { id: "cinnamon-roll", cat: "pastry", fx: "steam", name: "Cinnamon Roll", desc: "Roti gulung kayu manis dengan glaze lembut", price: 18000, img: "" },

  { id: "espresso", cat: "coffe", fx: "steam", name: "Espresso", desc: "Shot tunggal, pekat dan harum", price: 15000, img: "" },
  { id: "cafe-latte", cat: "coffe", fx: "steam", name: "Caffe Latte", desc: "Espresso dengan susu steam yang lembut", price: 18000, img: "" },

  { id: "choco-ice", cat: "non-coffe", fx: "bubble", name: "Chocolate Ice", desc: "Cokelat susu dingin yang creamy", price: 19000, img: "" },
  { id: "lemon-tea", cat: "non-coffe", fx: "bubble", name: "Lemon Tea", desc: "Teh segar dengan perasan lemon", price: 15000, img: "" }
);

/* Foto menu: coba foto sendiri di folder foto/, lalu foto bawaan, lalu foto cadangan kategori */
var IMG_POOL = {};
MENU.forEach(function (m) { if (m.img) (IMG_POOL[m.cat] = IMG_POOL[m.cat] || []).push(m.img); });
function imgChain(item) {
  var list = [(window.__FOTO && window.__FOTO[item.id]) || (FOTO_DIR + item.id + ".jpg")];
  if (item.img) list.push(item.img);
  var pool = IMG_POOL[item.cat] || [], n = pool.length, start = MENU.indexOf(item) % (n || 1);
  for (var k = 0; k < n; k++) { var u = pool[(start + k) % n]; if (list.indexOf(u) < 0) list.push(u); }
  return list;
}

function findItem(id) { for (var i = 0; i < MENU.length; i++) if (MENU[i].id === id) return MENU[i]; return null; }

return { CATEGORIES, MENU, imgChain, findItem };
};
__def["js/features/order-status.js"] = function () {
/* =========================================================
   Status pesanan (Diterima → Disiapkan → Siap diambil → Selesai).
   ========================================================= */
const { MENU_WA } = __req("js/config/constants.js");
const { emit } = __req("js/core/events.js");
const { toast } = __req("js/core/toast.js");
const { onRoute } = __req("js/core/router.js");
const { getOrder, patchOrder } = __req("js/state/orders.js");
const { state } = __req("js/state/store.js");
const { $, $all, esc } = __req("js/utils/dom.js");
const { rupiah } = __req("js/utils/format.js");
const { save } = __req("js/utils/storage.js");

/* ---------- Status pesanan (bagian dari halaman Keranjang) ---------- */
var STAGES = [
  { title: "Pesanan diterima", sub: "Barista sudah menerima pesananmu." },
  { title: "Sedang disiapkan", sub: "Coffe dan dessertmu sedang dibuat." },
  { title: "Siap diambil", sub: "Datang ke meja pickup dan sebutkan kodemu." },
  { title: "Selesai", sub: "Terima kasih sudah memesan di Nuvella Caffe." }
];

var SHIP = [
  { t: "Mencari driver", s: "Admin sedang memanggil driver untuk pesananmu." },
  { t: "Driver menuju kafe", s: "Driver sedang menuju Nuvella Caffe untuk mengambil pesananmu." },
  { t: "Sedang diantar", s: "Pesananmu sedang dalam perjalanan menuju lokasimu." },
  { t: "Pesanan tiba", s: "Pesanan sudah sampai di lokasimu. Selamat menikmati!" }
];

function currentStage() {
  if (!state.order) return -1;
  if (state.order.done) return 3;
  return state.order.status || 0;   // status diatur admin (halaman #/admin)
}

/* Ambil status terbaru dari admin */
async function syncStatus() {
  if (!state.order || state.order.done) return;
  try {
    var remote = await getOrder(state.order.code);
    if (!remote) return;
    if (remote.ship !== undefined && remote.ship !== state.order.ship) { state.order.ship = remote.ship; save("nuvella_order", state.order); paintStatus(); }
    if (remote.status === undefined || remote.status === state.order.status) return;
    state.order.status = remote.status;
    if (remote.status === 3) state.order.done = true;
    save("nuvella_order", state.order);
    if (remote.status === 3 && !state.order.rating) toast("Pesananmu selesai. Yuk beri rating bintang di halaman Keranjang.");
    paintStatus();
  } catch (e) {}
}

var pickedStars = 0;
function paintStars(n) {
  pickedStars = n;
  $("#rateStars").innerHTML = [1, 2, 3, 4, 5].map(function (i) {
    return '<button type="button" class="rate__star' + (i <= n ? " is-on" : "") + '" data-star="' + i + '" role="radio" aria-checked="' + (i === n) + '" aria-label="' + i + ' bintang">★</button>';
  }).join("");
}

function paintStatus() {
  if (!state.order) { clearInterval(state.statusTimer); return; }
  var stage = currentStage();
  $("#statusCode").textContent = state.order.code;
  $("#statusHeadline").textContent = STAGES[stage].title;
  var dv = state.order.delivery, ship = state.order.ship || 0;
  $("#shipBox").hidden = !dv;
  if (dv) {
    $("#shipCourier").textContent = "via " + dv.courier;
    $("#shipSteps").innerHTML = SHIP.map(function (x, i) {
      return '<li class="' + (i < ship || ship === 3 ? "is-done" : (i === ship ? "is-current" : "")) + '"><b>' + x.t + '</b>' + (i === ship ? '<span>' + x.s + '</span>' : "") + '</li>';
    }).join("");
    $("#shipAddr").textContent = "Alamat: " + dv.address;
  }
  $("#statusSub").textContent = dv && stage !== 3 ? SHIP[ship].s : stage === 3 ? STAGES[3].sub : "Ambil pukul " + state.order.pickup + " atas nama " + state.order.name + ". " + STAGES[stage].sub;
  $all("#timeline li").forEach(function (li) {
    var i = Number(li.getAttribute("data-step"));
    li.classList.toggle("is-done", i < stage || stage === 3);
    li.classList.toggle("is-current", i === stage && stage !== 3);
  });
  $("#statusItems").innerHTML = state.order.lines.map(function (l) {
    return '<li><span>' + l.qty + '× ' + esc(l.name) + '</span><span>' + rupiah(l.price * l.qty) + '</span></li>';
  }).join("");
  $("#statusTotal").textContent = rupiah(state.order.total);
  $("#markDone").hidden = stage !== 2;
  var rated = !!state.order.rating;
  $("#rateBox").hidden = !(stage === 3 && !rated);
  $("#rateDone").hidden = !(stage === 3 && rated);
  if (stage === 3 && rated) $("#rateDone").textContent = "Terima kasih! Ratingmu: " + "★".repeat(state.order.rating) + "☆".repeat(5 - state.order.rating);
  $("#clearStatus").hidden = !(stage === 3 && rated);   // rating wajib sebelum status ditutup
  if (stage === 3 && !rated) paintStars(pickedStars);
  $("#waStatus").href = "https://wa.me/" + MENU_WA + "?text=" + encodeURIComponent("Halo Nuvella Caffe, saya ingin menanyakan pesanan " + state.order.code + " atas nama " + state.order.name + ".");
  if (stage === 3) clearInterval(state.statusTimer);
}

function initOrderStatus() {
  $("#rateStars").addEventListener("click", function (e) {
    var b = e.target.closest("[data-star]");
    if (!b) return;
    paintStars(Number(b.getAttribute("data-star")));
    $("#rateError").hidden = true;
  });
  $("#rateSubmit").addEventListener("click", function () {
    if (!pickedStars) { $("#rateError").hidden = false; return; }
    var note = $("#rateNote").value.trim();
    state.order.rating = pickedStars;
    state.order.review = note;
    save("nuvella_order", state.order);
    patchOrder(state.order.code, { rating: pickedStars, review: note }).catch(function () {});
    $("#rateNote").value = "";
    pickedStars = 0;
    toast("Terima kasih atas ratingmu!");
    paintStatus();
  });
  $("#markDone").addEventListener("click", function () {
    state.order.done = true; state.order.status = 3; save("nuvella_order", state.order); paintStatus();
    patchOrder(state.order.code, { status: 3 }).catch(function () {});
  });
  $("#clearStatus").addEventListener("click", function () {
    state.order = null; save("nuvella_order", null); emit("cart:render");
  });
  /* hentikan pembaruan status saat meninggalkan halaman Keranjang */
  onRoute(function (page) { if (page !== "keranjang") clearInterval(state.statusTimer); });
  setInterval(syncStatus, 4000);
  window.addEventListener("storage", syncStatus);
}

return { paintStatus, initOrderStatus };
};
__def["js/features/faq.js"] = function () {
/* =========================================================
   Halaman FAQ (accordion).
   ========================================================= */
const { FAQ } = __req("js/data/faq.js");
const { $ } = __req("js/utils/dom.js");
const { ICON_PLUS_SM } = __req("js/utils/icons.js");

function initFaq() {
  /* ---------- FAQ (accordion) ---------- */
  $("#faqList").innerHTML = FAQ.map(function (g, gi) {
    return '<div class="faq__group"><h2>' + g.topic + '</h2>' + g.items.map(function (q, qi) {
      var id = "faq-" + gi + "-" + qi;
      return '<div class="acc"><button type="button" class="acc__btn" aria-expanded="false" aria-controls="' + id + '">' +
        '<span>' + q[0] + '</span>' + ICON_PLUS_SM + '</button>' +
        '<div class="acc__panel" id="' + id + '" role="region"><div><p>' + q[1] + '</p></div></div></div>';
    }).join("") + '</div>';
  }).join("");

  $("#faqList").addEventListener("click", function (e) {
    var btn = e.target.closest(".acc__btn");
    if (!btn) return;
    var acc = btn.parentElement;
    var open = !acc.classList.contains("is-open");
    acc.classList.toggle("is-open", open);
    btn.setAttribute("aria-expanded", open);
  });
}

return { initFaq };
};
__def["js/data/faq.js"] = function () {
/* =========================================================
   Isi halaman FAQ.
   ========================================================= */

const FAQ = [
  { topic: "Pemesanan", items: [
    ["Bagaimana cara pesan dulu lalu ambil?", "Pilih menu, buka Keranjang, isi nama dan nomor HP, lalu pilih jam ambil. Pesananmu langsung masuk ke barista dan siap di meja pickup sesuai jam yang kamu pilih."],
    ["Bagaimana saya tahu pesanan sudah siap?", "Buka halaman Keranjang. Status pesanan tampil di bagian atas: Diterima, Sedang disiapkan, dan Siap diambil. Sebutkan kode pesanan (misalnya NV-1234) di meja pickup."],
    ["Bisakah saya mengubah atau membatalkan pesanan?", "Bisa, selama pesanan belum masuk tahap Sedang disiapkan. Hubungi kami lewat WhatsApp 0857-5518-3802 dengan menyebutkan kode pesanan."],
    ["Metode pembayaran apa saja yang diterima?", "Pembayaran dilakukan di kasir saat mengambil pesanan: tunai, QRIS, dan kartu debit."]
  ]},
  { topic: "Menu", items: [
    ["Apakah ada menu tanpa kafein?", "Ada. Orange Squash dan semua dessert bebas kafein. Matcha mengandung sedikit kafein."],
    ["Bisakah saya mengatur tingkat manis?", "Bisa. Tulis di kolom Catatan saat memesan, misalnya less sugar atau tanpa gula."]
  ]},
  { topic: "Lokasi", items: [
    ["Di mana alamat Nuvella Caffe?", "Jl. Pahlawan No.15, Madiun. Tekan tombol Buka di Google Maps pada bagian Lokasi di footer bawah halaman untuk petunjuk arah."],
    ["Apakah tersedia tempat parkir?", "Tersedia parkir motor di depan kafe dan parkir mobil terbatas di sisi jalan."]
  ]},
  { topic: "Jam Operasional", items: [
    ["Jam berapa Nuvella Caffe buka?", "Senin–Jumat pukul 07.00–22.00, Sabtu–Minggu pukul 08.00–23.00."],
    ["Apakah bisa pesan di luar jam buka?", "Bisa. Pilih jam ambil keesokan harinya, pesanan akan disiapkan begitu kami buka."]
  ]},
  { topic: "Reservasi", items: [
    ["Apakah bisa reservasi meja?", "Bisa untuk 6 orang atau lebih. Buka menu Reservasi di navigasi atas, isi detail kedatangan, lalu klik tombol Reservasi untuk langsung terhubung ke WhatsApp Admin."],
    ["Apakah bisa untuk acara atau meeting?", "Bisa. Area lantai dua dapat dipakai untuk acara kecil hingga 20 orang. Pilih Area Lantai 2 pada halaman Reservasi."]
  ]},
  { topic: "Sustainability", items: [
    ["Apakah bisa membawa tumbler sendiri?", "Sangat bisa, dan kamu mendapat potongan Rp2.000 untuk setiap minuman yang disajikan di tumbler sendiri."],
    ["Dari mana biji coffe Nuvella berasal?", "Kami memakai biji coffe dari petani di lereng Gunung Wilis dan Ijen, dibeli langsung dengan harga yang adil."],
    ["Bagaimana kemasan untuk pesanan bawa pulang?", "Gelas dan kotak kami berbahan kertas yang bisa didaur ulang, dan ampas coffe kami olah menjadi kompos."]
  ]}
];

return { FAQ };
};
__def["js/features/hours.js"] = function () {
/* =========================================================
   Tabel jam operasional dan label "Buka sekarang".
   ========================================================= */
const { HOURS } = __req("js/data/hours.js");
const { $ } = __req("js/utils/dom.js");
const { pad } = __req("js/utils/format.js");

/* ---------- Jam operasional ---------- */
function renderHours() {
  var today = new Date().getDay();
  var order7 = [1, 2, 3, 4, 5, 6, 0];
  $("#hoursTable tbody").innerHTML = order7.map(function (i) {
    var h = HOURS[i];
    return '<tr class="' + (i === today ? "is-today" : "") + '"><td>' + h.day + '</td><td>' + pad(h.open) + ".00–" + h.close + '.00</td></tr>';
  }).join("");

  var now = new Date();
  var h = HOURS[today];
  var mins = now.getHours() * 60 + now.getMinutes();
  var open = mins >= h.open * 60 && mins < h.close * 60;
  var el = $("#openNow");
  if (open) {
    el.textContent = "Buka sekarang · sampai " + h.close + ".00";
    el.hidden = false;
    el.classList.remove("is-closed");
  } else {
    el.textContent = "";
    el.hidden = true;
  }
}

return { renderHours };
};
__def["js/features/mascot.js"] = function () {
/* =========================================================
   Maskot Novella di beranda (suara, lompat, bunga).
   ========================================================= */
const { playWelcome, unlockAudio } = __req("js/core/audio.js");
const { FLOWER_COLORS, flowerSVG } = __req("js/effects/flowers.js");
const { $ } = __req("js/utils/dom.js");
const { REDUCE } = __req("js/utils/env.js");
const { rnd } = __req("js/utils/format.js");

function burstFlowers() {
  var wrap = $("#mascotWrap");
  if (!wrap || REDUCE) return;
  for (var i = 0; i < 16; i++) {
    var el = document.createElement("span");
    var a = (i / 16) * Math.PI * 2 + rnd(-0.2, 0.2), d = rnd(110, 230);
    var c = FLOWER_COLORS[i % FLOWER_COLORS.length];
    el.className = "burst";
    el.style.setProperty("--sz", rnd(22, 38).toFixed(0) + "px");
    el.style.setProperty("--dx", (Math.cos(a) * d).toFixed(0) + "px");
    el.style.setProperty("--dy", (Math.sin(a) * d * 0.8 - 40).toFixed(0) + "px");
    el.style.setProperty("--r", rnd(-300, 300).toFixed(0) + "deg");
    el.innerHTML = flowerSVG(c[0], c[1], 5);
    wrap.appendChild(el);
    (function (node) { setTimeout(function () { node.remove(); }, 1300); })(el);
  }
}

/* ---------- Maskot Novella di beranda (suara + lompat + bunga) ---------- */
function initHomeMascot() {
  var mascot = $("#mascot"), bubble = $("#bubbleText");
  if (!mascot) return;
  var tapped = 0;
  var lines = ["Hai, aku <b>Novella</b>! ☕", "Hehe, geli! 😆", "Wuih! Bunga-bunga untukmu 🌼", "Yuk pesan kopi favoritmu! ☕"];
  mascot.addEventListener("click", function () {
    unlockAudio();
    playWelcome();
    burstFlowers();
    mascot.classList.remove("is-jump"); void mascot.offsetWidth; mascot.classList.add("is-jump");
    setTimeout(function () { mascot.classList.remove("is-jump"); }, 760);
    if (bubble) bubble.innerHTML = lines[tapped % lines.length];
    var bub = $("#bubble"); if (bub) { bub.classList.remove("pop"); void bub.offsetWidth; bub.classList.add("pop"); }
    tapped++;
  });
}

return { burstFlowers, initHomeMascot };
};
__def["js/features/member.js"] = function () {
/* =========================================================
   Kartu member digital (#/member): daftar, lihat stempel, kode penukaran hadiah.
   Stempel & aktivasi diatur admin (lihat features/admin.js).
   ========================================================= */
const { MEMBER_EXPIRE_MONTHS, MEMBER_PRICE, MEMBER_RENEW_PRICE, MEMBER_TARGET, MENU_WA } = __req("js/config/constants.js");
const { onRoute } = __req("js/core/router.js");
const { toast } = __req("js/core/toast.js");
const { bungaRate, currentReward, defaultSettings, expiryDate, getMember, getSettings, isExpired, nextTier, normPhone, saveMember, tierOf } = __req("js/state/members.js");
const { $, esc } = __req("js/utils/dom.js");
const { rupiah } = __req("js/utils/format.js");
const { load, save } = __req("js/utils/storage.js");

var PHONE_KEY = "nuvella_member_phone";
var myPhone = load(PHONE_KEY, null);
var member = null;
var settings = defaultSettings();
var timer = null;

function validPhone(p) { return /^08[0-9]{8,11}$/.test(p); }

function stampsHTML(n) {
  var out = "", i;
  for (i = 1; i <= MEMBER_TARGET; i++) {
    out += '<li class="mstamp' + (i <= n ? " is-on" : "") + (i === MEMBER_TARGET ? " is-last" : "") + '">' + (i === MEMBER_TARGET && i > n ? "🎁" : i) + "</li>";
  }
  return out;
}

function paintCard() {
  var m = member;
  var dead = isExpired(m);
  var reward = m.redeem ? m.redeem : currentReward(m, settings);
  var left = Math.max(0, MEMBER_TARGET - m.stamps);
  var tier = tierOf(m, settings), next = nextTier(m, settings);
  var live = m.active && !dead;
  var dateFmt = { day: "numeric", month: "long", year: "numeric" };

  $("#mbrCardBox").innerHTML =
    '<div class="mcard mcard--' + tier.id + (live ? "" : " is-pending") + '">' +
      '<div class="mcard__top"><span class="mcard__brand">Nuvella <small>CAFFE</small></span><span class="mcard__tag">' + (live ? esc(tier.name).toUpperCase() : "MEMBER") + '</span></div>' +
      '<p class="mcard__name">' + esc(m.name) + '</p>' +
      '<p class="mcard__phone">' + esc(m.phone) + '</p>' +
      '<ol class="mstamps" aria-label="Poin ' + m.stamps + ' dari ' + MEMBER_TARGET + '">' + stampsHTML(m.stamps) + '</ol>' +
      '<p class="mcard__count"><b>' + m.stamps + '</b> / ' + MEMBER_TARGET + ' poin</p>' +
      (!m.active ? '<div class="mcard__lock">Menunggu aktivasi</div>' : (dead ? '<div class="mcard__lock">Membership hangus</div>' : "")) +
    '</div>';

  var side = "";
  if (!m.active) {
    var wa = "https://wa.me/" + MENU_WA + "?text=" + encodeURIComponent("Halo Nuvella Caffe, saya " + m.name + " (" + m.phone + ") ingin mengaktifkan kartu member digital. Biaya " + rupiah(MEMBER_PRICE) + ".");
    side += '<h2 class="summary__title">Aktifkan kartumu</h2>' +
      '<p class="mbr-text">Bayar <b>' + rupiah(MEMBER_PRICE) + '</b> ke kasir atau konfirmasi lewat WhatsApp. Setelah admin mengaktifkan, poin mulai dihitung dan diskon member langsung berlaku.</p>' +
      '<a class="btn btn--primary btn--block" href="' + wa + '" target="_blank" rel="noopener">Konfirmasi aktivasi via WhatsApp</a>';
  } else if (dead) {
    var wa2 = "https://wa.me/" + MENU_WA + "?text=" + encodeURIComponent("Halo Nuvella Caffe, saya " + m.name + " (" + m.phone + ") ingin mengaktifkan ulang kartu member yang hangus. Biaya " + rupiah(MEMBER_RENEW_PRICE) + ".");
    side += '<h2 class="summary__title">Membership hangus</h2>' +
      '<p class="mbr-text">Kartumu tidak aktif lebih dari ' + MEMBER_EXPIRE_MONTHS + ' bulan, jadi hangus. Aktifkan ulang dengan <b>' + rupiah(MEMBER_RENEW_PRICE) + '</b>. Poin dan level mulai dari awal.</p>' +
      '<a class="btn btn--primary btn--block" href="' + wa2 + '" target="_blank" rel="noopener">Aktifkan ulang via WhatsApp</a>';
  } else {
    side += '<div class="mbr-tier mbr-tier--' + tier.id + '"><b>Level ' + esc(tier.name) + '</b><span>' + (tier.discount > 0 ? 'Diskon <b>' + tier.discount + '%</b> setiap pesanan (pakai nomor HP yang sama).' : 'Belum ada diskon di level ini. Naik level untuk dapat diskon.') + '</span></div>';
    if (next) side += '<p class="mbr-text">Kurang <b>' + (next.min - (m.lifetime || 0)) + '</b> poin lagi menuju <b>' + esc(next.name) + '</b> (diskon ' + next.discount + '%).</p>';
    else side += '<p class="mbr-text">Kamu sudah di level tertinggi. 🎉</p>';
    if (m.redeem) {
      side += '<div class="mbr-redeem"><p class="mbr-redeem__label">Hadiah terbuka! 🎉</p>' +
        '<p class="mbr-redeem__title">' + esc(m.redeem.title) + '</p>' +
        (m.redeem.desc ? '<p class="mbr-text">' + esc(m.redeem.desc) + '</p>' : "") +
        '<p class="mbr-redeem__code" aria-label="Kode penukaran">' + esc(m.redeem.code) + '</p>' +
        '<p class="mbr-text">Tunjukkan kode ini ke kasir. Setelah dikonfirmasi, kartumu kembali ke 0 poin untuk siklus berikutnya.</p></div>';
    } else {
      side += '<h2 class="summary__title">Hadiah siklus ini</h2>' +
        '<p class="mbr-redeem__title">' + esc(reward.title) + '</p>' +
        (reward.desc ? '<p class="mbr-text">' + esc(reward.desc) + '</p>' : "") +
        '<p class="mbr-text">Kurang <b>' + left + '</b> poin lagi. Setiap pembelian yang memenuhi syarat mendapat 1 poin' +
        (settings.minPurchase ? " (minimal " + rupiah(settings.minPurchase) + ")" : "") + '.</p>';
    }
    var canPay = (m.bunga || 0) >= settings.bunga.payout;
    side += '<div class="mbr-bunga"><span>Tabungan bunga</span><strong>' + rupiah(m.bunga || 0) + '</strong>' +
      '<small>Selesaikan ' + MEMBER_TARGET + ' poin, dapat bunga ' + settings.bunga.rate + '% dari belanja (tiap pesanan minimal ' + rupiah(settings.bunga.min) + '). Belanja siklus ini: ' + rupiah(m.cycleSpend || 0) + '. Bisa ditukar ke Dana atau ShopeePay jika sudah ' + rupiah(settings.bunga.payout) + '.</small>' +
      (m.payout ? '<small><b>Permintaan ' + rupiah(m.payout.amount) + ' ke ' + esc(m.payout.wallet) + ' ' + esc(m.payout.number) + ' sedang diproses admin.</b></small>' :
        (canPay ? '<select id="mbrWallet" aria-label="E-wallet"><option>Dana</option><option>ShopeePay</option></select><input id="mbrWalletNo" type="text" inputmode="numeric" placeholder="Nomor e-wallet" aria-label="Nomor e-wallet" /><button type="button" class="btn btn--primary btn--block" id="mbrPayout">Tukar ' + rupiah(m.bunga) + '</button>' : '')) +
      '</div>';
    side += '<p class="mbr-text">Aktif sampai <b>' + expiryDate(m).toLocaleDateString("id-ID", dateFmt) + '</b>. Tiap ada poin baru, masa aktif diperpanjang ' + MEMBER_EXPIRE_MONTHS + ' bulan.</p>';
  }
  if (m.active && m.cycles) side += '<p class="mbr-text">Hadiah sudah ditukar <b>' + m.cycles + '×</b>.</p>';
  side += '<button type="button" class="btn btn--secondary btn--block" id="mbrRefresh">Cek poin terbaru</button>' +
    '<button type="button" class="mbr-forget" id="mbrForget">Keluar dari kartu ini</button>';
  $("#mbrSide").innerHTML = side;
}

function paint() {
  $("#mbrJoin").hidden = !!member;
  $("#mbrCard").hidden = !member;
  if (!member) { $("#mbrJoinReward").textContent = settings.firstReward.title; return; }
  paintCard();
}

async function load_() {
  try { settings = await getSettings(); } catch (e) {}
  if (myPhone) {
    try { member = await getMember(myPhone); }
    catch (e) { /* offline: tetap tampilkan data terakhir */ }
  }
  paint();
}

function renderMember() {
  clearInterval(timer);
  load_();
  timer = setInterval(load_, 5000);
}

function setErr(id, msg) { var el = $(id); el.textContent = msg || ""; el.hidden = !msg; }

function initMember() {
  onRoute(function (page) { if (page !== "member") clearInterval(timer); });
  window.addEventListener("storage", load_);

  $("#mbrForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    var name = $("#mbrName").value.trim();
    var phone = normPhone($("#mbrPhone").value);
    setErr("#mbrNameErr", name.length < 2 ? "Isi nama minimal 2 huruf." : "");
    setErr("#mbrPhoneErr", validPhone(phone) ? "" : "Nomor HP harus 10–13 angka dan diawali 08, contoh: 085755183802.");
    if (name.length < 2 || !validPhone(phone)) return;
    try {
      var found = await getMember(phone);
      if (found) {
        member = found;
        toast("Nomor ini sudah punya kartu member. Kartumu dibuka.");
      } else {
        member = { phone: phone, name: name, createdAt: Date.now(), active: false, stamps: 0, cycles: 0, stampedOrders: [], history: [] };
        await saveMember(member);
        toast("Kartu dibuat. Tinggal aktivasi " + rupiah(MEMBER_PRICE) + ".");
      }
      myPhone = phone; save(PHONE_KEY, phone);
      $("#mbrForm").reset();
      paint();
    } catch (err) {
      toast("Gagal membuat kartu. Periksa koneksi lalu coba lagi.");
    }
  });

  $("#mbrLookupForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    var phone = normPhone($("#mbrLookupPhone").value);
    if (!validPhone(phone)) { setErr("#mbrLookupErr", "Masukkan nomor HP yang diawali 08."); return; }
    try {
      var found = await getMember(phone);
      if (!found) { setErr("#mbrLookupErr", "Nomor ini belum terdaftar sebagai member."); return; }
      setErr("#mbrLookupErr", "");
      member = found; myPhone = phone; save(PHONE_KEY, phone);
      $("#mbrLookupForm").reset();
      paint();
    } catch (err) {
      setErr("#mbrLookupErr", "Tidak bisa mengambil data. Periksa koneksi.");
    }
  });

  $("#mbrSide").addEventListener("click", async function (e) {
    if (e.target.closest("#mbrPayout")) {
      var no = $("#mbrWalletNo").value.replace(/[^0-9]/g, "");
      if (no.length < 10 || no.length > 13) { toast("Isi nomor e-wallet 10–13 angka."); return; }
      try {
        var fresh = await getMember(myPhone);
        if (!fresh || fresh.payout || (fresh.bunga || 0) < settings.bunga.payout) { member = fresh; paint(); return; }
        fresh.payout = { wallet: $("#mbrWallet").value, number: no, amount: fresh.bunga, at: Date.now() };
        await saveMember(fresh); member = fresh; paint();
        toast("Permintaan dikirim. Admin akan mentransfer ke e-walletmu.");
      } catch (err) { toast("Gagal mengirim permintaan. Coba lagi."); }
      return;
    }
    if (e.target.closest("#mbrRefresh")) { await load_(); toast("Kartu diperbarui."); }
    if (e.target.closest("#mbrForget")) {
      if (!confirm("Keluar dari kartu ini di perangkat ini? Poinmu tetap aman dan bisa dibuka lagi dengan nomor HP.")) return;
      myPhone = null; member = null; save(PHONE_KEY, null);
      paint();
    }
  });
}

return { renderMember, initMember };
};
__def["js/features/menu.js"] = function () {
/* =========================================================
   Halaman Menu: tab kategori, kartu menu, tombol tambah, dan rekomendasi di beranda.
   ========================================================= */
const { playWav } = __req("js/core/audio.js");
const { navigate } = __req("js/core/router.js");
const { toast } = __req("js/core/toast.js");
const { CATEGORIES, findItem, imgChain, MENU } = __req("js/data/menu.js");
const { updateCartUI } = __req("js/features/cart.js");
const { state } = __req("js/state/store.js");
const { $, esc } = __req("js/utils/dom.js");
const { short } = __req("js/utils/format.js");
const { ICON_PLUS } = __req("js/utils/icons.js");
const { save } = __req("js/utils/storage.js");

/* ---------- Menu & Foto Produk ---------- */
function itemRow(item, i) {
  var ware = (item.cat === "coffe" || item.cat === "non-coffe") ? "glass" : "plate";
  return '<li class="menu-item menu-item--' + ware + '" style="--i:' + i + '">' +
    '<div class="menu-item__thumb">' +
      '<div class="menu-item__imgwrap"><img class="menu-item__img" src="' + imgChain(item)[0] + '" data-fb="' + imgChain(item).slice(1).join("|") + '" alt="' + esc(item.name) + '" loading="lazy" /></div>' +
    '</div>' +
    '<div class="menu-item__info"><p class="menu-item__name">' + esc(item.name) + '</p><p class="menu-item__desc">' + esc(item.desc) + '</p></div>' +
    '<span class="menu-item__price">' + short(item.price) + '</span>' +
    '<button type="button" class="add-btn" data-add="' + item.id + '" aria-label="Tambah ' + esc(item.name) + ' ke keranjang">' +
    ICON_PLUS + '<span class="spinner" aria-hidden="true"></span></button>' +
    '</li>';
}

function renderTabs() {
  $("#menuTabs").innerHTML = CATEGORIES.map(function (c) {
    return '<button type="button" role="tab" class="tab" data-cat="' + c.id + '" aria-selected="' + (c.id === state.activeCat) + '">' + c.name + '</button>';
  }).join("");
}

/* Jumlah menu yang ditampilkan per kategori (di halaman Menu dan Rekomendasi beranda).
   Ubah angka ini kalau mau menampilkan lebih banyak; sisa menu tetap ada di data/menu.js. */
var PER_CATEGORY = 3;
function visibleItems(cat) {
  return MENU.filter(function (m) { return m.cat === cat; }).slice(0, PER_CATEGORY);
}

function renderMenu() {
  renderTabs();
  $("#menuList").innerHTML = visibleItems(state.activeCat).map(itemRow).join("");
}

/** Halaman Menu: pilih kategori dari URL (#/menu/pastry) lalu tampilkan. */
function showMenuPage(parts) {
  if (parts[1]) {
    var catSlug = parts[1] === "kopi" ? "coffe" : (parts[1] === "non-kopi" ? "non-coffe" : parts[1]);
    for (var i = 0; i < CATEGORIES.length; i++) if (CATEGORIES[i].id === catSlug) state.activeCat = catSlug;
  }
  renderMenu();
}

function initMenu() {
  document.addEventListener("error", function (e) {
    var t = e.target;
    if (!t || t.tagName !== "IMG" || !t.classList.contains("menu-item__img")) return;
    var q = (t.getAttribute("data-fb") || "").split("|").filter(Boolean);
    if (!q.length) return;
    t.setAttribute("data-fb", q.slice(1).join("|"));
    t.src = q[0];
  }, true);

  $("#menuTabs").addEventListener("click", function (e) {
    var btn = e.target.closest("[data-cat]");
    if (!btn) return;
    navigate("/menu/" + btn.getAttribute("data-cat"));
  });

  /* Tambah ke keranjang: loading → notifikasi */
  document.addEventListener("click", function (e) {
    var btn = e.target.closest && e.target.closest("[data-add]");
    if (!btn || btn.classList.contains("is-loading")) return;
    var item = findItem(btn.getAttribute("data-add"));
    btn.classList.add("is-loading");
    btn.disabled = true;
    btn.setAttribute("aria-busy", "true");
    setTimeout(function () {
      state.cart[item.id] = (state.cart[item.id] || 0) + 1;
      save("nuvella_cart", state.cart);
      btn.classList.remove("is-loading");
      btn.disabled = false;
      btn.removeAttribute("aria-busy");
      updateCartUI(true);
      playWav();
      toast(item.name + " ditambahkan ke keranjang", "Lihat", function () { navigate("/keranjang"); });
    }, 550);
  });

  /* ---------- Beranda: signature ---------- */
  /* Gambar menu rekomendasi: foto asli, bingkai piring yang seragam */
  var favoritesEl = $("#favoritesList");
  if (favoritesEl) {
    favoritesEl.innerHTML = visibleItems("signature").map(itemRow).join("");
  }
}

return { showMenuPage, initMenu };
};
__def["js/features/reservation.js"] = function () {
/* =========================================================
   Reservasi meja & acara, dikirim ke WhatsApp admin.
   ========================================================= */
const { WA_NUMBER } = __req("js/config/constants.js");
const { toast } = __req("js/core/toast.js");
const { $, esc } = __req("js/utils/dom.js");
const { pad } = __req("js/utils/format.js");

/* ---------- Reservasi (Langsung ke WhatsApp Admin) ---------- */
function initReservationDate() {
  var dateInput = $("#resDate");
  if (dateInput && !dateInput.value) {
    var tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
    dateInput.value = tomorrow.getFullYear() + "-" + pad(tomorrow.getMonth() + 1) + "-" + pad(tomorrow.getDate());
  }
}

function buildReservationWaUrl() {
  var name = $("#resName").value.trim() || "-";
  var phone = $("#resPhone").value.trim() || "-";
  var date = $("#resDate").value || "-";
  var time = $("#resTime").value || "-";
  var pax = $("#resPax").value || "-";
  var area = $("#resArea").value || "-";
  var note = $("#resNote").value.trim();

  var msg = "Halo Admin Nuvella Caffe, saya ingin melakukan reservasi:\n" +
    "- Nama: " + name + "\n" +
    "- No. HP: " + phone + "\n" +
    "- Tanggal: " + date + "\n" +
    "- Jam: " + time + "\n" +
    "- Jumlah Orang: " + pax + " orang\n" +
    "- Area: " + area +
    (note ? "\n- Catatan: " + note : "");
  return "https://wa.me/" + WA_NUMBER + "?text=" + encodeURIComponent(msg);
}

function renderReservation() {
  initReservationDate();
  var rows = [
    ["Nama", $("#resName").value.trim() || "—"],
    ["Nomor HP", $("#resPhone").value.trim() || "—"],
    ["Tanggal", $("#resDate").value || "—"],
    ["Jam", $("#resTime").value || "—"],
    ["Jumlah Tamu", ($("#resPax").value || "0") + " orang"],
    ["Area", $("#resArea").value || "—"]
  ];
  if ($("#resNote").value.trim()) rows.push(["Catatan", $("#resNote").value.trim()]);
  $("#resSummaryItems").innerHTML = rows.map(function (r) {
    return '<li><span>' + esc(r[0]) + '</span><span>' + esc(r[1]) + '</span></li>';
  }).join("");
  $("#waReserveDirect").href = buildReservationWaUrl();
}

var MAX_TABLE = 6, MAX_FLOOR2 = 20;
function maxPax() { return $("#resArea").value.indexOf("Lantai 2") >= 0 ? MAX_FLOOR2 : MAX_TABLE; }

function validateReservation() {
  var nameVal = $("#resName").value.trim();
  var phoneVal = $("#resPhone").value.trim();
  var dateVal = $("#resDate").value;
  var paxVal = Number($("#resPax").value);

  var okName = nameVal.length >= 2;
  $("#resNameError").textContent = okName ? "" : "Isi nama pemesan minimal 2 huruf.";
  $("#resNameError").hidden = okName;
  if (okName) $("#resName").removeAttribute("aria-invalid"); else $("#resName").setAttribute("aria-invalid", "true");

  var okPhone = /^08[0-9]{8,11}$/.test(phoneVal);
  $("#resPhoneError").textContent = okPhone ? "" : "Masukkan nomor HP aktif 10–13 angka yang diawali 08.";
  $("#resPhoneError").hidden = okPhone;
  if (okPhone) $("#resPhone").removeAttribute("aria-invalid"); else $("#resPhone").setAttribute("aria-invalid", "true");

  var okDate = !!dateVal;
  $("#resDateError").textContent = okDate ? "" : "Pilih tanggal reservasi.";
  $("#resDateError").hidden = okDate;

  var mp = maxPax();
  var okPax = Number.isInteger(paxVal) && paxVal >= 1 && paxVal <= mp;
  $("#resPaxError").textContent = okPax ? "" : (mp === MAX_TABLE ? "Meja reguler maksimal 6 orang." : "Jumlah tamu antara 1 sampai 20 orang.");
  $("#resPaxError").hidden = okPax;

  if (!okName) { $("#resName").focus(); return false; }
  if (!okPhone) { $("#resPhone").focus(); return false; }
  if (!okDate) { $("#resDate").focus(); return false; }
  if (!okPax) { $("#resPax").focus(); return false; }
  return true;
}

function initReservation() {
  ["#resName", "#resPhone", "#resDate", "#resTime", "#resPax", "#resArea", "#resNote"].forEach(function (sel) {
    var el = $(sel);
    if (el) { el.addEventListener("input", renderReservation); el.addEventListener("change", renderReservation); }
  });

  function syncPax() { $("#resPax").max = maxPax(); }
  $("#resArea").addEventListener("change", syncPax);
  syncPax();
  /* tombol WhatsApp langsung juga harus lolos validasi */
  $("#waReserveDirect").addEventListener("click", function (e) { if (!validateReservation()) e.preventDefault(); });

  $("#reservationForm").addEventListener("submit", function (e) {
    e.preventDefault();
    if (!validateReservation()) return;
    var waUrl = buildReservationWaUrl();
    toast("Mengarahkan reservasi ke WhatsApp Admin...");
    var win = window.open(waUrl, "_blank", "noopener");
    if (!win) window.location.href = waUrl;
  });
}

return { renderReservation, initReservation };
};
__def["js/features/cake-studio/order.js"] = function () {
/* =========================================================
   Alur pesan kue: Order Summary → gambar PNG → WhatsApp admin.
   ========================================================= */
const { CK_WA } = __req("js/config/constants.js");
const { toast } = __req("js/core/toast.js");
const { CK, ckFind } = __req("js/data/cake-options.js");
const { cakeMeta, ck } = __req("js/state/cake.js");
const { $, $all, esc } = __req("js/utils/dom.js");
