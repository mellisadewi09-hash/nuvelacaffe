      stampLine(o) +
      (o.rating ? '<p class="adm-rating"><b>Rating</b><span class="stars">' + '★'.repeat(o.rating) + '☆'.repeat(5 - o.rating) + '</span>' + (o.review ? ' ' + esc(o.review) : '') + '</p>' : (st === 3 ? '<p class="adm-rating"><b>Rating</b>Belum diberi</p>' : '')) +
    '</div>' +
    '<ul class="summary__items">' + lines + '</ul>' +
    deliveryBlock(o) +
    (o.discount ? '<div class="summary__total"><span>Diskon member ' + esc(o.tier || "") + ' ' + o.discountPct + '%</span><strong>−' + rupiah(o.discount) + '</strong></div>' : "") +
    '<div class="summary__total"><span>Total</span><strong>' + rupiah(o.total) + '</strong></div>' +
    '<div class="adm-stages" role="group" aria-label="Ubah status ' + esc(o.code) + '">' + btns + '</div>' +
    '<button type="button" class="adm-del" data-del="' + esc(o.code) + '">Hapus pesanan</button>' +
  '</li>';
}

function paintOrders() {
  paintFilters();
  var list = orders.filter(function (o) { return filter === "all" || String(o.status || 0) === filter; });
  $("#adminList").innerHTML = list.map(card).join("");
  $("#adminEmpty").hidden = list.length > 0;
}

/* ---------- Tab admin ---------- */
var TABS = ["orders", "members", "reward", "ratings", "finance"];
var PANES = { orders: "#admOrders", members: "#admMembers", reward: "#admReward", ratings: "#admRatings", finance: "#admFinance" };

function showTab(name) {
  tab = name;
  TABS.forEach(function (t) { $(PANES[t]).hidden = t !== name; });
  $all("#adminTabs [data-atab]").forEach(function (b) { b.setAttribute("aria-selected", b.getAttribute("data-atab") === name); });
  if (name === "reward") paintReward();
  if (name === "finance") paintFinance();
}

function stars(n) { return "★".repeat(n) + "☆".repeat(5 - n); }

/* ---------- Member ---------- */
function memberState(m) { return !m.active ? 0 : (isExpired(m) ? 3 : (m.redeem ? 2 : 1)); }
var MEMBER_BADGE = ["Menunggu aktivasi", "Aktif", "Siap tukar hadiah", "Hangus"];
var HISTORY_LABEL = { stamp: "+ stempel", unstamp: "− stempel", unlock: "Hadiah terbuka", redeem: "Hadiah ditukar", activate: "Diaktifkan", renew: "Diaktifkan ulang", bunga: "Bunga" };

function memberCard(m) {
  var st = memberState(m);
  var pct = Math.round(Math.min(m.stamps, MEMBER_TARGET) / MEMBER_TARGET * 100);
  var btns = "";
  if (!m.active) btns += '<button type="button" class="btn btn--primary adm-mbtn adm-mbtn--wide" data-mact="activate" data-phone="' + esc(m.phone) + '">Aktifkan (sudah bayar ' + rupiah(MEMBER_PRICE) + ')</button>';
  else if (st === 3) btns += '<button type="button" class="btn btn--primary adm-mbtn adm-mbtn--wide" data-mact="renew" data-phone="' + esc(m.phone) + '">Aktifkan ulang (bayar ' + rupiah(MEMBER_RENEW_PRICE) + ')</button>';
  else {
    btns += '<button type="button" class="btn btn--secondary adm-mbtn" data-mact="plus" data-phone="' + esc(m.phone) + '">+ Stempel</button>' +
      '<button type="button" class="btn btn--secondary adm-mbtn" data-mact="minus" data-phone="' + esc(m.phone) + '">− Stempel</button>';
    if (m.payout) btns += '<button type="button" class="btn btn--primary adm-mbtn adm-mbtn--wide" data-mact="paid" data-phone="' + esc(m.phone) + '">Sudah ditransfer ' + rupiah(m.payout.amount) + ' ke ' + esc(m.payout.wallet) + '</button>';
    else if (m.bunga > 0) btns += '<button type="button" class="btn btn--secondary adm-mbtn adm-mbtn--wide" data-mact="bunga" data-phone="' + esc(m.phone) + '">Pakai saldo bunga ' + rupiah(m.bunga) + '</button>';
    if (m.redeem) btns += '<button type="button" class="btn btn--primary adm-mbtn adm-mbtn--wide" data-mact="redeem" data-phone="' + esc(m.phone) + '">Konfirmasi penukaran ' + esc(m.redeem.code) + '</button>';
  }
  var hist = (m.history || []).slice(-8).reverse().map(function (h) {
    return '<li><span>' + (HISTORY_LABEL[h.type] || h.type) + (h.note ? " · " + esc(h.note) : "") + '</span><span>' + when(h.at) + '</span></li>';
  }).join("");
  return '<li class="adm-card adm-card--s' + st + '">' +
    '<div class="adm-card__head"><strong class="adm-card__code">' + esc(m.name) + '</strong><span class="adm-badge adm-badge--s' + st + '">' + MEMBER_BADGE[st] + '</span><small>Daftar ' + when(m.createdAt) + '</small></div>' +
    '<div class="adm-card__meta">' +
      '<p><b>HP</b> <a href="' + waLink(m.phone) + '" target="_blank" rel="noopener">' + esc(m.phone) + '</a></p>' +
      (m.active && settings ? '<p><b>Level</b> ' + esc(tierOf(m, settings).name) + ' · diskon ' + tierOf(m, settings).discount + '%</p>' : "") +
      '<p><b>Stempel</b> ' + m.stamps + ' / ' + MEMBER_TARGET + ' (total ' + (m.lifetime || 0) + ')</p>' +
      (m.active ? '<p><b>Bunga</b> ' + rupiah(m.bunga || 0) + (settings ? ' · ' + bungaRate(m, settings) + '% dari belanja 15 stempel' : "") + '</p>' + (m.payout ? '<p><b>Tarik</b> ' + esc(m.payout.wallet) + ' ' + esc(m.payout.number) + ' · ' + rupiah(m.payout.amount) + '</p>' : "") + '</p><p><b>Aktif s/d</b> ' + expiryDate(m).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" }) + '</p>' : "") +
      '<div class="adm-meter" aria-hidden="true"><span style="width:' + pct + '%"></span></div>' +
      '<p><b>Ditukar</b> ' + m.cycles + '×</p>' +
      (m.redeem ? '<p><b>Kode</b> <strong>' + esc(m.redeem.code) + '</strong></p><p><b>Hadiah</b> ' + esc(m.redeem.title) + '</p>' : '') +
    '</div>' +
    '<div class="adm-stages">' + btns + '</div>' +
    (hist ? '<details class="adm-hist"><summary>Riwayat terbaru</summary><ul class="summary__items">' + hist + '</ul></details>' : '') +
    '<button type="button" class="adm-del" data-mact="delete" data-phone="' + esc(m.phone) + '">Hapus member</button>' +
  '</li>';
}

function paintMembers() {
  var list = members.slice();
  /* urutan: siap tukar → menunggu aktivasi → aktif */
  list.sort(function (a, b) { var o = { 2: 0, 3: 1, 0: 2, 1: 3 }; return o[memberState(a)] - o[memberState(b)]; });
  var pending = members.filter(function (m) { return !m.active; }).length;
  var ready = members.filter(function (m) { return m.redeem; }).length;
  var dead = members.filter(function (m) { return isExpired(m); }).length;
  $("#memberSummary").textContent = members.length + " member · " + pending + " menunggu aktivasi · " + ready + " siap tukar hadiah · " + dead + " hangus";
  $("#memberList").innerHTML = list.map(memberCard).join("");
  $("#memberEmpty").hidden = list.length > 0;
}

async function memberAction(act, phone) {
  var m = await getMember(phone);
  if (!m) { toast("Member tidak ditemukan."); refresh(); return; }
  var st = await getSettings();
  if (act === "delete") {
    if (!confirm("Hapus kartu member " + m.name + "? Semua stempelnya hilang dan tidak bisa dibatalkan.")) return;
    await removeMember(phone);
    toast("Member dihapus.");
    refresh();
    return;
  }
  if (act === "activate") {
    activate(m, false);
    await addFinance({ type: "in", cat: "Member", amount: MEMBER_PRICE, note: "Aktivasi " + m.name });
    toast("Kartu " + m.name + " aktif.");
  } else if (act === "renew") {
    activate(m, true);
    await addFinance({ type: "in", cat: "Member", amount: MEMBER_RENEW_PRICE, note: "Aktifkan ulang " + m.name });
    toast("Kartu " + m.name + " aktif lagi, mulai dari 0.");
  } else if (act === "paid") {
    if (!m.payout) { toast("Tidak ada permintaan tarik bunga."); return; }
    var pay = spendBunga(m, m.payout.amount);
    await addFinance({ type: "out", cat: "Bunga member", amount: pay, note: "Transfer " + m.payout.wallet + " " + m.payout.number + " (" + m.name + ")" });
    m.payout = null;
    toast("Transfer " + rupiah(pay) + " tercatat.");
  } else if (act === "bunga") {
    var use = spendBunga(m, m.bunga);
    if (!use) { toast("Tidak ada saldo bunga."); return; }
    await addFinance({ type: "out", cat: "Bunga member", amount: use, note: "Saldo bunga dipakai " + m.name });
    toast("Saldo bunga " + rupiah(use) + " dipakai.");
  } else if (act === "plus") {
    var r = giveStamp(m, st, "Manual admin");
    if (r === "inactive") { toast("Aktifkan kartunya dulu."); return; }
    if (r === "expired") { toast("Membership hangus. Aktifkan ulang dulu."); return; }
    if (r === "full") { toast("Kartu penuh. Konfirmasi penukaran hadiah dulu."); return; }
    toast(m.redeem ? "Stempel penuh! Kode hadiah: " + m.redeem.code : "Stempel " + m.name + ": " + m.stamps + "/" + MEMBER_TARGET);
  } else if (act === "minus") {
    if (!takeStamp(m)) { toast("Tidak ada stempel yang bisa dikurangi."); return; }
    toast("Stempel " + m.name + ": " + m.stamps + "/" + MEMBER_TARGET);
  } else if (act === "redeem") {
    if (!confirm("Konfirmasi penukaran kode " + m.redeem.code + " untuk " + m.name + "?\nKartu akan kembali ke 0 stempel.")) return;
    confirmRedeem(m);
    toast("Hadiah ditukar. Kartu " + m.name + " kembali ke 0.");
  }
  await saveMember(m);
  refresh();
}

/* Stempel dari pesanan: 1 pesanan = 1 stempel, hanya sekali */
async function awardOrder(code, quiet) {
  var o = orders.filter(function (x) { return x.code === code; })[0];
  if (!o || o.stamped) return;
  var known = memberByPhone(o.phone);
  if (!known || !known.active) return;
  var m = await getMember(known.phone);
  if (!m || !m.active) return;
  if (isExpired(m)) { if (!quiet) toast("Membership " + m.name + " hangus, aktifkan ulang dulu."); return; }
  var st = await getSettings();
  if ((o.total || 0) < st.minPurchase) { if (!quiet) toast("Total pesanan di bawah minimal stempel."); return; }
  if (m.stampedOrders.indexOf(code) < 0) {
    var r = giveStamp(m, st, "Pesanan " + code);
    if (r === "full") { toast("Kartu " + m.name + " sudah penuh. Tukarkan hadiahnya dulu."); return; }
    m.stampedOrders.push(code);
    addSpend(m, st, o.total);
    var bunga = m.stamps >= MEMBER_TARGET ? creditCycleBunga(m, st, "15 stempel") : 0;
    await saveMember(m);
    if (bunga) toast(m.name + " dapat bunga " + rupiah(bunga) + " (tabungan).");
    toast(m.redeem ? m.name + " mencapai " + MEMBER_TARGET + " stempel! Kode: " + m.redeem.code : "Stempel " + m.name + ": " + m.stamps + "/" + MEMBER_TARGET);
  }
  await patchOrder(code, { stamped: true });
}

/* ---------- Pengaturan hadiah ---------- */
async function paintReward() {
  var st;
  try { st = await getSettings(); } catch (e) { return; }
  $("#rwFirstTitle").value = st.firstReward.title;
  $("#rwFirstDesc").value = st.firstReward.desc || "";
  $("#rwTitle").value = st.reward.title;
  $("#rwDesc").value = st.reward.desc || "";
  $("#rwMin").value = st.minPurchase || "";
  $("#tgDisc0").value = st.tiers[0].discount;
  $("#tgMin1").value = st.tiers[1].min;
  $("#tgDisc1").value = st.tiers[1].discount;
  $("#tgMin2").value = st.tiers[2].min;
  $("#tgDisc2").value = st.tiers[2].discount;
  $("#bgMin").value = st.bunga.min;
  $("#bgRate").value = st.bunga.rate;
  $("#bgPayout").value = st.bunga.payout;
  var meta;
  if (!st.updatedAt) meta = "Belum pernah diatur, sekarang memakai hadiah bawaan. Hadiah siklus berikutnya sebaiknya diganti tiap " + MEMBER_REWARD_MONTHS + " bulan.";
  else {
    var due = new Date(st.updatedAt); due.setMonth(due.getMonth() + MEMBER_REWARD_MONTHS);
    meta = "Terakhir diubah " + new Date(st.updatedAt).toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) + ". " +
      (Date.now() >= due.getTime() ? "Sudah lewat " + MEMBER_REWARD_MONTHS + " bulan, saatnya ganti hadiah." : "Jadwal ganti berikutnya: " + due.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" }) + ".");
  }
  $("#rewardMeta").textContent = meta;
}

/* ---------- Rating pelanggan ---------- */
function paintRatings() {
  var rated = orders.filter(function (o) { return o.rating; });
  var waiting = orders.filter(function (o) { return (o.status || 0) === 3 && !o.rating; }).length;
  var sum = rated.reduce(function (a, o) { return a + o.rating; }, 0);
  var avg = rated.length ? (sum / rated.length).toFixed(1) : "–";
  var dist = [5, 4, 3, 2, 1].map(function (n) {
    return n + "★ " + rated.filter(function (o) { return o.rating === n; }).length;
  }).join(" · ");
  $("#ratingSummary").innerHTML = '<strong class="adm-ratesum__avg">' + avg + ' <span class="stars">★</span></strong>' +
    '<span>' + rated.length + ' rating · ' + waiting + ' pesanan selesai belum diberi rating</span><small>' + dist + '</small>';

  var tabs = [{ id: "all", name: "Semua", n: rated.length }].concat([5, 4, 3, 2, 1].map(function (n) {
    return { id: String(n), name: n + "★", n: rated.filter(function (o) { return o.rating === n; }).length };
  }));
  $("#ratingFilters").innerHTML = tabs.map(function (t) {
    return '<button type="button" class="tab" data-rfilter="' + t.id + '" aria-selected="' + (t.id === ratingFilter) + '">' + t.name + ' (' + t.n + ')</button>';
  }).join("");

  var list = rated.filter(function (o) { return ratingFilter === "all" || String(o.rating) === ratingFilter; });
  $("#ratingList").innerHTML = list.map(function (o) {
    return '<li class="adm-card adm-card--s3"><div class="adm-card__head"><strong class="adm-card__code">' + esc(o.name) + '</strong><span class="stars adm-rating">' + stars(o.rating) + '</span><small>' + when(o.createdAt) + '</small></div>' +
      '<div class="adm-card__meta"><p><b>HP</b> <a href="' + waLink(o.phone) + '" target="_blank" rel="noopener">' + esc(o.phone) + '</a></p>' +
      '<p><b>Pesanan</b> ' + esc(o.code) + ' · ' + rupiah(o.total) + '</p>' +
      '<p><b>Komentar</b> ' + (o.review ? esc(o.review) : "–") + '</p></div></li>';
  }).join("");
  $("#ratingEmpty").hidden = list.length > 0;
}

function paintAll() {
  paintOrders();
  paintMembers();
  paintRatings();
  paintSummary();
  if (tab === "finance") paintFinance();
}

/* ---------- Keuangan (hanya admin) ---------- */
function monthKey(ts) { var d = new Date(ts); return d.getFullYear() * 12 + d.getMonth(); }

/* Rekap satu bulan: pemasukan pesanan (status Selesai) + biaya member, pengeluaran manual */
function recap(year, month) {
  var key = year * 12 + month;
  var r = { orders: 0, orderCount: 0, memberIn: 0, otherIn: 0, discount: 0, out: 0, outList: [], inList: [] };
  orders.forEach(function (o) {
    if ((o.status || 0) !== 3 || monthKey(o.doneAt || o.createdAt) !== key) return;
    r.orders += o.total || 0; r.orderCount++; r.discount += o.discount || 0;
  });
  finance.forEach(function (e) {
    if (monthKey(e.at) !== key) return;
    if (e.type === "in") { if (e.cat === "Member") r.memberIn += e.amount; else r.otherIn += e.amount; r.inList.push(e); }
    else { r.out += e.amount; r.outList.push(e); }
  });
  r.income = r.orders + r.memberIn + r.otherIn;
  r.net = r.income - r.out;
  return r;
}

function paintSummary() {
  var now = new Date(), r = recap(now.getFullYear(), now.getMonth());
  var el = $("#adminMode");
  el.hidden = false;
  el.innerHTML = '<b>' + MONTHS[now.getMonth()] + ' ' + now.getFullYear() + '</b>' +
    '<span>Pemasukan <strong>' + rupiah(r.income) + '</strong></span>' +
    '<span>Pengeluaran <strong>' + rupiah(r.out) + '</strong></span>' +
    '<span>Bersih <strong>' + rupiah(r.net) + '</strong></span>';
}

function paintFinance() {
  var ys = $("#finYear"), thisYear = new Date().getFullYear();
  if (!ys.options.length) {
    for (var y = thisYear - 2; y <= thisYear + 1; y++) ys.innerHTML += '<option value="' + y + '">' + y + '</option>';
  }
  ys.value = String(finYear);
  $("#finMonths").innerHTML = MONTHS.map(function (name, i) {
    var r = recap(finYear, i);
    return '<button type="button" class="adm-fin__m" data-fmonth="' + i + '" aria-pressed="' + (i === finMonth) + '"><span>' + name + '</span><strong>' + rupiah(r.income) + '</strong><small>keluar ' + rupiah(r.out) + '</small></button>';
  }).join("");

  var r = recap(finYear, finMonth), today = new Date();
  var dflt = (finYear === today.getFullYear() && finMonth === today.getMonth() ? today : new Date(finYear, finMonth, 1));
  var dstr = dflt.getFullYear() + "-" + String(dflt.getMonth() + 1).padStart(2, "0") + "-" + String(dflt.getDate()).padStart(2, "0");
  var rows = r.outList.map(function (e) {
    return '<li><span>' + esc(e.cat) + (e.note ? " · " + esc(e.note) : "") + ' <small>' + when(e.at) + '</small></span><span>' + rupiah(e.amount) + ' <button type="button" class="adm-link" data-fdel="' + esc(e.id) + '">hapus</button></span></li>';
  }).join("");
  $("#finDetail").innerHTML =
    '<div class="adm-card adm-card--s3 adm-fin__detail">' +
      '<h2 class="summary__title">' + MONTHS[finMonth] + ' ' + finYear + '</h2>' +
      '<div class="adm-card__meta">' +
        '<p><b>Pesanan</b> ' + rupiah(r.orders) + ' (' + r.orderCount + ' pesanan selesai)</p>' +
        '<p><b>Member</b> ' + rupiah(r.memberIn) + '</p>' +
        (r.otherIn ? '<p><b>Lainnya</b> ' + rupiah(r.otherIn) + '</p>' : '') +
        '<p><b>Pemasukan</b> <strong>' + rupiah(r.income) + '</strong></p>' +
        '<p><b>Pengeluaran</b> <strong>' + rupiah(r.out) + '</strong></p>' +
        '<p><b>Bersih</b> <strong>' + rupiah(r.net) + '</strong></p>' +
        '<p><b>Diskon member</b> ' + rupiah(r.discount) + ' (sudah dipotong dari pesanan)</p>' +
      '</div>' +
      (rows ? '<ul class="summary__items">' + rows + '</ul>' : '<p class="field__hint">Belum ada pengeluaran bulan ini.</p>') +
      '<form class="adm-fin__form" id="finForm" novalidate>' +
        '<select id="finCat" aria-label="Jenis pengeluaran"><option>Kembalian</option><option>Belanja bahan</option><option>Gaji</option><option>Operasional</option><option>Lainnya</option></select>' +
        '<input id="finNote" type="text" maxlength="80" placeholder="Keterangan (opsional)" aria-label="Keterangan" />' +
        '<input id="finAmount" type="number" min="1" step="500" inputmode="numeric" placeholder="Jumlah (Rp)" aria-label="Jumlah pengeluaran" />' +
        '<input id="finDate" type="date" value="' + dstr + '" aria-label="Tanggal" />' +
        '<button type="submit" class="btn btn--primary">Catat pengeluaran</button>' +
        '<p class="field__error" id="finError" role="alert" hidden></p>' +
      '</form>' +
    '</div>';
}

async function refresh() {
  if (!loggedIn()) return;
  try {
    orders = await listOrders();
    $("#adminMsg").hidden = true;
    var codes = orders.map(function (o) { return o.code; });
    if (knownCodes) {
      var fresh = codes.filter(function (c) { return knownCodes.indexOf(c) < 0; });
      if (fresh.length) toast("Pesanan baru masuk: " + fresh.join(", "));
    }
    knownCodes = codes;
    try { members = await listMembers(); } catch (e2) { /* orders tetap tampil */ }
    try { settings = await getSettings(); } catch (e3) { /* pakai bawaan */ }
    try { finance = await listFinance(); } catch (e4) { /* keuangan manual tidak tampil */ }
    paintAll();
  } catch (e) {
    $("#adminMsg").textContent = "Tidak bisa mengambil pesanan. Periksa koneksi atau alamat database.";
    $("#adminMsg").hidden = false;
  }
}

function renderAdmin() {
  var on = loggedIn();
  $("#adminLogin").hidden = on;
  $("#adminPanel").hidden = !on;
  clearInterval(timer);
  if (on) {
    knownCodes = null;
    showTab(tab);
    refresh();
    timer = setInterval(refresh, 5000);
  }
}

function initAdmin() {
  onRoute(function (page) { if (page !== "admin") clearInterval(timer); });

  $("#adminForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    var err = $("#adminError");
    err.hidden = true;
    if (!window.crypto || !crypto.subtle) {
      err.textContent = "Login admin butuh https atau localhost.";
      err.hidden = false;
      return;
    }
    var email = $("#adminEmail").value.trim().toLowerCase();
    var hash = await sha256(email + ":" + $("#adminPass").value);
    if (email === ADMIN_EMAIL.toLowerCase() && hash === ADMIN_PASS_HASH) {
      failCount = 0;
      setLoggedIn(true);
      $("#adminPass").value = "";
      renderAdmin();
      return;
    }
    failCount++;
    err.textContent = "Email atau kata sandi salah.";
    err.hidden = false;
    var btn = $("#adminForm button[type=submit]");
    btn.disabled = true;
    setTimeout(function () { btn.disabled = false; }, Math.min(failCount, 5) * 1000);
  });

  $("#adminLogout").addEventListener("click", function () {
    setLoggedIn(false);
    renderAdmin();
  });
  $("#adminRefresh").addEventListener("click", refresh);

  $("#adminFilters").addEventListener("click", function (e) {
    var b = e.target.closest("[data-filter]");
    if (!b) return;
    filter = b.getAttribute("data-filter");
    paintOrders();
  });

  $("#adminList").addEventListener("click", async function (e) {
    var set = e.target.closest("[data-set]");
    var shipBtn = e.target.closest("[data-ship]");
    var copy = e.target.closest("[data-copy]");
    if (copy) { try { await navigator.clipboard.writeText(copy.getAttribute("data-copy")); toast("Alamat disalin."); } catch (e3) { toast("Tidak bisa menyalin."); } return; }
    var del = e.target.closest("[data-del]");
    var stamp = e.target.closest("[data-stamp]");
    try {
      if (shipBtn) {
        var c1 = shipBtn.getAttribute("data-code"), n1 = Number(shipBtn.getAttribute("data-ship"));
        await patchOrder(c1, { ship: n1 });
        toast("Pengantaran " + c1 + ": " + SHIP[n1]);
        refresh();
      } else if (set) {
        var code0 = set.getAttribute("data-code"), n = Number(set.getAttribute("data-set"));
        await patchOrder(code0, n === 3 ? { status: n, doneAt: Date.now() } : { status: n });
        toast("Status " + code0 + ": " + STAGES[n]);
        if (n === 3) { try { await awardOrder(code0, true); } catch (e2) { toast("Status tersimpan, tapi stempel member gagal. Coba lagi."); } }
        refresh();
      } else if (stamp) {
        await awardOrder(stamp.getAttribute("data-stamp"), false);
        refresh();
      } else if (del) {
        var code = del.getAttribute("data-del");
        if (!confirm("Hapus pesanan " + code + "? Tindakan ini tidak bisa dibatalkan.")) return;
        await removeOrder(code);
        refresh();
      }
    } catch (err) {
      toast("Gagal menyimpan perubahan. Coba lagi.");
    }
  });

  /* tab: Pesanan / Member / Hadiah / Rating */
  $("#adminTabs").addEventListener("click", function (e) {
    var b = e.target.closest("[data-atab]");
    if (b) showTab(b.getAttribute("data-atab"));
  });

  /* aksi kartu member */
  $("#memberList").addEventListener("click", async function (e) {
    var b = e.target.closest("[data-mact]");
    if (!b) return;
    try { await memberAction(b.getAttribute("data-mact"), b.getAttribute("data-phone")); }
    catch (err) { toast("Gagal menyimpan perubahan member. Coba lagi."); }
  });

  /* keuangan */
  $("#finYear").addEventListener("change", function (e) { finYear = Number(e.target.value); paintFinance(); });
  $("#finMonths").addEventListener("click", function (e) {
    var b = e.target.closest("[data-fmonth]");
    if (!b) return;
    finMonth = Number(b.getAttribute("data-fmonth"));
    paintFinance();
  });
  $("#finDetail").addEventListener("click", async function (e) {
    var d = e.target.closest("[data-fdel]");
    if (!d) return;
    if (!confirm("Hapus catatan pengeluaran ini?")) return;
    try { await removeFinance(d.getAttribute("data-fdel")); finance = await listFinance(); paintAll(); }
    catch (err) { toast("Gagal menghapus. Coba lagi."); }
  });
  $("#finDetail").addEventListener("submit", async function (e) {
    if (e.target.id !== "finForm") return;
    e.preventDefault();
    var amount = Math.floor(Number($("#finAmount").value) || 0), err = $("#finError");
    var dv = $("#finDate").value;
    if (amount <= 0) { err.textContent = "Isi jumlah pengeluaran."; err.hidden = false; return; }
    var at = dv ? new Date(dv + "T12:00:00").getTime() : Date.now();
    try {
      await addFinance({ type: "out", cat: $("#finCat").value, amount: amount, note: $("#finNote").value.trim(), at: at });
      finance = await listFinance();
      toast("Pengeluaran dicatat.");
      paintAll();
    } catch (e2) { err.textContent = "Gagal menyimpan. Coba lagi."; err.hidden = false; }
  });

  /* filter rating */
  $("#ratingFilters").addEventListener("click", function (e) {
    var b = e.target.closest("[data-rfilter]");
    if (!b) return;
    ratingFilter = b.getAttribute("data-rfilter");
    paintRatings();
  });

  /* pengaturan hadiah */
  $("#rwPresets").addEventListener("click", function (e) {
    var b = e.target.closest("[data-preset]");
    if (!b) return;
    var p = PRESETS[b.getAttribute("data-preset")];
    $("#rwTitle").value = p.title;
    $("#rwDesc").value = p.desc;
  });
  $("#rewardForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    var err = $("#rewardError");
    var first = $("#rwFirstTitle").value.trim(), next = $("#rwTitle").value.trim();
    if (!first || !next) { err.textContent = "Judul hadiah pertama dan hadiah berikutnya wajib diisi."; err.hidden = false; return; }
    var num = function (id) { return Math.max(0, Number($(id).value) || 0); };
    var d0 = num("#tgDisc0"), d1 = num("#tgDisc1"), d2 = num("#tgDisc2"), g1 = num("#tgMin1"), g2 = num("#tgMin2");
    if (g2 <= g1) { err.textContent = "Syarat stempel Platinum harus lebih besar dari Gold."; err.hidden = false; return; }
    if (d0 > 50 || d1 > 50 || d2 > 50) { err.textContent = "Diskon maksimal 50%."; err.hidden = false; return; }
    if (!(d0 <= d1 && d1 <= d2)) { err.textContent = "Diskon level yang lebih tinggi sebaiknya sama atau lebih besar."; err.hidden = false; return; }
    err.hidden = true;
    try {
      await saveSettings({
        tiers: [{ id: "silver", name: "Silver", min: 0, discount: d0 }, { id: "gold", name: "Gold", min: g1, discount: d1 }, { id: "platinum", name: "Platinum", min: g2, discount: d2 }],
        bunga: { min: num("#bgMin"), rate: num("#bgRate"), payout: num("#bgPayout") },
        firstReward: { title: first, desc: $("#rwFirstDesc").value.trim() },
        reward: { title: next, desc: $("#rwDesc").value.trim() },
        minPurchase: Math.max(0, Number($("#rwMin").value) || 0),
        updatedAt: Date.now()
      });
      toast("Pengaturan hadiah tersimpan.");
      paintReward();
    } catch (e2) {
      err.textContent = "Gagal menyimpan. Periksa koneksi lalu coba lagi.";
      err.hidden = false;
    }
  });
}

return { renderAdmin, initAdmin };
};
__def["js/config/constants.js"] = function () {
/* =========================================================
   Konstanta global: nomor WhatsApp dan lokasi aset.
   ========================================================= */

const WA_NUMBER = "6285755183802";      // admin utama: pesanan & reservasi
const MENU_WA = "6285792304941";        // WhatsApp menu (keranjang/status) & footer
const CK_WA = "6285792304941";          // admin Cake Studio
/* Akun admin (halaman #/admin). Password TIDAK disimpan di sini, hanya hash SHA-256 dari "email:password". */
const ADMIN_EMAIL = "nuvellacaffe@gmail.com";
const ADMIN_PASS_HASH = "dc54f41e04556d4614110c4880ce0a2b8903c48cbafd7776e659b8c8d1e38225";
/* Alamat Firebase Realtime Database supaya admin bisa melihat pesanan dari HP/perangkat pelanggan lain.
   Contoh: "https://nama-proyek-default-rtdb.asia-southeast1.firebasedatabase.app"
   Kosong = pesanan hanya tersimpan di browser yang sama (mode lokal). */
const ORDERS_DB_URL = "";
const FOTO_DIR = "assets/foto/";        // foto menu buatan sendiri: assets/foto/<id-menu>.jpg
const SFX_FILE = "assets/audio/sound.wav";  // suara "tambah ke keranjang"

/* Kartu member digital */
const MEMBER_PRICE = 20000;              // biaya aktivasi kartu member
const MEMBER_RENEW_PRICE = 5000;         // biaya aktifkan ulang jika membership hangus
const MEMBER_EXPIRE_MONTHS = 5;          // tidak ada aktivitas selama ini = membership hangus
const MEMBER_TARGET = 15;                // jumlah stempel untuk membuka hadiah
const MEMBER_FIRST_REWARD = { title: "Paket dessert spesial + 1 minuman non-coffee gratis", desc: "Hadiah untuk penukaran pertama kartu member." };
const MEMBER_DEFAULT_REWARD = { title: "Minuman & dessert spesial", desc: "Hadiah siklus berikutnya. Admin bisa menggantinya kapan saja." };
const MEMBER_REWARD_MONTHS = 2;          // pengingat: hadiah diganti tiap 2 bulan
/* Level member: makin tinggi level, makin besar diskon. Admin bisa mengubah diskon & syarat stempel di halaman admin. */
const MEMBER_TIERS = [
  { id: "silver", name: "Silver", min: 0, discount: 2 },
  { id: "gold", name: "Gold", min: 30, discount: 4 },
  { id: "platinum", name: "Platinum", min: 60, discount: 6 }
];
/* Bunga member (tabungan): selesai 15 stempel = dapat bunga "rate" persen dari total belanja 15 pesanan itu
   (hanya pesanan minimal "min"). Saldo bisa ditukar ke Dana / ShopeePay jika sudah mencapai "payout". Admin bisa mengubahnya. */
const MEMBER_BUNGA = { min: 30000, rate: 2, payout: 10000 };

return { WA_NUMBER, MENU_WA, CK_WA, ADMIN_EMAIL, ADMIN_PASS_HASH, ORDERS_DB_URL, FOTO_DIR, SFX_FILE, MEMBER_PRICE, MEMBER_RENEW_PRICE, MEMBER_EXPIRE_MONTHS, MEMBER_TARGET, MEMBER_FIRST_REWARD, MEMBER_DEFAULT_REWARD, MEMBER_REWARD_MONTHS, MEMBER_TIERS, MEMBER_BUNGA };
};
__def["js/core/toast.js"] = function () {
/* =========================================================
   Notifikasi kecil di layar.
   ========================================================= */
const { $, $all, esc } = __req("js/utils/dom.js");
const { ICON_CHECK } = __req("js/utils/icons.js");

/* ---------- Notifikasi ---------- */
function toast(text, actionLabel, action) {
  var el = document.createElement("div");
  el.className = "toast";
  el.setAttribute("role", "status");
  el.innerHTML = ICON_CHECK + '<span class="toast__text">' + esc(text) + '</span>' +
    (actionLabel ? '<button type="button" class="toast__action">' + actionLabel + '</button>' : "");
  if (action) el.querySelector(".toast__action").addEventListener("click", function () { action(); dismiss(); });
  $("#toasts").appendChild(el);
  var all = $all(".toast"); if (all.length > 3) all[0].remove();
  var t = setTimeout(dismiss, 2800);
  function dismiss() { clearTimeout(t); el.classList.add("is-leaving"); setTimeout(function () { el.remove(); }, 180); }
}

return { toast };
};
