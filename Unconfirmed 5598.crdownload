  pl("mug", 145, 25, -770, 14, 20, "");

  /* meja & kursi pengunjung (kiri-kanan) */
  function chair(cx, cz, dir) {
    pl("shd", cx, FL - 0.8, cz, 60, 60, "rotateX(90deg)");
    pl("chleg", cx, 109, cz + dir * 16, 34, 40, "");
    pl("chleg", cx, 109, cz - dir * 16, 34, 40, "");
    box("m-leather", cx, 89.5, cz, 38, 5, 38);
