/* bentuk hati dari kurva parametrik (dipakai untuk gambar & uji titik) */
var HEART = (function () {
  var pts = [], k = 8.2, minY = 1e9, maxY = -1e9, i, t, x, y;
  for (i = 0; i < 120; i++) {
    t = i / 120 * Math.PI * 2;
    x = 16 * Math.pow(Math.sin(t), 3) * k;
