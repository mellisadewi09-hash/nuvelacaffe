const { initOrderStatus } = __req("js/features/order-status.js");
const { initReservation, renderReservation } = __req("js/features/reservation.js");
const { initCakeOrder } = __req("js/features/cake-studio/order.js");
const { initCakeStudio, renderCake } = __req("js/features/cake-studio/studio.js");

/* Halaman → apa yang dijalankan saat halaman dibuka */
registerPage("menu", { render: showMenuPage });
registerPage("cake-studio", { render: function () { renderCake(); } });
registerPage("member", { render: renderMember });
registerPage("keranjang", { render: renderCartPage });
registerPage("reservasi", { render: renderReservation });
registerPage("admin", { render: renderAdmin });
registerPage("tentang", { onEnter: restartCafe });

/* Pasang event listener per fitur */
initRouter();
initMenu();
initCart();
initCheckout();
initOrderStatus();
initReservation();
initAdmin();
initMember();
initFaq();
initShopPointer();
initTilt();
initHeroParallax();

/* Bangun tampilan awal */
mountHeroFx();
buildBackground();
mountAmbient();
buildCafe();
splitWords();
initReveal();
renderHours();
renderReservation();
updateCartUI(false);
initCakeStudio();
initCakeOrder();
initHomeMascot();
initKelasAnim();

route();

