};
__def["js/utils/color.js"] = function () {
/* =========================================================
   Konversi & pencahayaan warna (dipakai Cake Studio).
   ========================================================= */

function hexToRgb(h) {
  h = String(h).replace("#", "");
  if (h.length === 3) h = h.replace(/(.)/g, "$1$1");
  var n = parseInt(h, 16); if (isNaN(n)) n = 0xf4e3c3;
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function shade(hex, amt) {
  var c = hexToRgb(hex);
  var t = amt < 0 ? 0 : 255, p = Math.abs(amt);
  return "rgb(" + c.map(function (v) { return Math.round((t - v) * p + v); }).join(",") + ")";
}
function luminance(hex) { var c = hexToRgb(hex); return (0.299 * c[0] + 0.587 * c[1] + 0.114 * c[2]) / 255; }

return { shade, luminance };
};
__req("js/main.js");

/* Isi gambar banner beranda (foto menu asli Nuvella) */
document.querySelectorAll("img[data-foto]").forEach(function (im) { im.src = window.__FOTO[im.getAttribute("data-foto")] || ""; });
