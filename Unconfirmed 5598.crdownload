__def["js/state/orders.js"] = function () {
/* =========================================================
   Penyimpanan daftar pesanan untuk admin.
   - ORDERS_DB_URL kosong  → localStorage (hanya terlihat di browser yang sama)
   - ORDERS_DB_URL terisi  → Firebase Realtime Database lewat REST (terlihat di semua perangkat)
   ========================================================= */
const { ORDERS_DB_URL } = __req("js/config/constants.js");
const { load, save } = __req("js/utils/storage.js");

var KEY = "nuvella_orders";
var isRemote = !!ORDERS_DB_URL;

function url(code) {
  return ORDERS_DB_URL.replace(/\/+$/, "") + "/orders" + (code ? "/" + encodeURIComponent(code) : "") + ".json";
}
function send(method, u, body) {
  return fetch(u, { method: method, headers: { "Content-Type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) })
    .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); });
}

async function addOrder(order) {
  if (isRemote) { await send("PUT", url(order.code), order); return; }
  var all = load(KEY, []).filter(function (o) { return o.code !== order.code; });
  all.push(order);
  save(KEY, all);
}

async function listOrders() {
  var all;
  if (isRemote) { var data = await send("GET", url()); all = data ? Object.keys(data).map(function (k) { return data[k]; }) : []; }
  else all = load(KEY, []);
  return all.sort(function (a, b) { return b.createdAt - a.createdAt; });
}

async function getOrder(code) {
  if (isRemote) return send("GET", url(code));
  return load(KEY, []).filter(function (o) { return o.code === code; })[0] || null;
}

async function patchOrder(code, patch) {
  if (isRemote) { await send("PATCH", url(code), patch); return; }
  var all = load(KEY, []);
  all.forEach(function (o) { if (o.code === code) Object.assign(o, patch); });
  save(KEY, all);
}

async function removeOrder(code) {
  if (isRemote) { await send("DELETE", url(code)); return; }
  save(KEY, load(KEY, []).filter(function (o) { return o.code !== code; }));
}

return { isRemote, addOrder, listOrders, getOrder, patchOrder, removeOrder };
};
__def["js/features/cart.js"] = function () {
/* =========================================================
   Badge keranjang, halaman Keranjang, dan tombol +/- jumlah.
   ========================================================= */
const { on } = __req("js/core/events.js");
const { renderSlots, updateWaLink } = __req("js/features/checkout.js");
const { paintStatus } = __req("js/features/order-status.js");
const { cartCount, cartLines, cartTotal } = __req("js/state/cart.js");
const { state } = __req("js/state/store.js");
const { $, esc } = __req("js/utils/dom.js");
const { rupiah } = __req("js/utils/format.js");
const { save } = __req("js/utils/storage.js");

/* ---------- Keranjang (badge) ---------- */
function updateCartUI(bump) {
  var count = cartCount();
  var badge = $("#cartCount");
  badge.textContent = count;
  badge.hidden = count === 0;
  $("#cartOpen").setAttribute("aria-label", "Buka keranjang, " + count + " item");
  if (bump) {
    badge.classList.remove("bump"); void badge.offsetWidth; badge.classList.add("bump");
    var btn = $("#cartOpen");
    btn.classList.remove("wiggle"); void btn.offsetWidth; btn.classList.add("wiggle");
  }
  var pg = $('[data-page="keranjang"]');
  if (pg && !pg.hidden) renderCartPage();
}

/* ---------- Halaman Keranjang (isi keranjang + status) ---------- */
function renderCartPage() {
  var lines = cartLines();
  var hasOrder = !!state.order;

  $("#cartEmptyPage").hidden = lines.length > 0 || hasOrder;
  $("#cartBody").hidden = lines.length === 0;
  $("#statusBody").hidden = !hasOrder;

  $("#cartItems").innerHTML = lines.map(function (l) {
    return '<li class="cart-line">' +
      '<img class="cart-line__img" src="' + l.item.img + '" alt="' + esc(l.item.name) + '" loading="lazy" />' +
      '<div><p class="cart-line__name">' + esc(l.item.name) + '</p><p class="cart-line__price">' + rupiah(l.item.price) + '</p></div>' +
      '<p class="cart-line__total">' + rupiah(l.item.price * l.qty) + '</p>' +
      '<span></span>' +
      '<div class="qty"><button type="button" data-dec="' + l.item.id + '" aria-label="Kurangi ' + esc(l.item.name) + '">−</button>' +
      '<span>' + l.qty + '</span>' +
      '<button type="button" data-inc="' + l.item.id + '" aria-label="Tambah ' + esc(l.item.name) + '">+</button></div>' +
      '</li>';
  }).join("");

  $("#summaryItems").innerHTML = lines.map(function (l) {
    return '<li><span>' + l.qty + '× ' + esc(l.item.name) + '</span><span>' + rupiah(l.item.price * l.qty) + '</span></li>';
  }).join("");
  $("#summaryTotal").textContent = rupiah(cartTotal());

  if (lines.length) {
    if (!$("#slots").children.length) renderSlots();
    updateWaLink();
  }

  clearInterval(state.statusTimer);
  if (hasOrder) {
    paintStatus();
    if (!state.order.done) state.statusTimer = setInterval(paintStatus, 1000);
  }
}

function initCart() {
  $("#cartItems").addEventListener("click", function (e) {
    var inc = e.target.closest("[data-inc]");
    var dec = e.target.closest("[data-dec]");
    if (inc) state.cart[inc.getAttribute("data-inc")]++;
    if (dec) {
      var id = dec.getAttribute("data-dec");
      state.cart[id]--;
      if (state.cart[id] <= 0) delete state.cart[id];
    }
    if (inc || dec) { save("nuvella_cart", state.cart); updateCartUI(false); }
  });

  /* modul lain (checkout, status) memberi tahu lewat pesan, bukan impor langsung */
  on("cart:changed", function () { updateCartUI(false); });
  on("cart:render", renderCartPage);
}

return { updateCartUI, renderCartPage, initCart };
};
__def["js/core/events.js"] = function () {
/* =========================================================
   Pesan antar-modul sederhana (menghindari modul saling mengimpor).
   ========================================================= */

var handlers = {};
function on(name, fn) { (handlers[name] = handlers[name] || []).push(fn); }
function emit(name, data) { (handlers[name] || []).forEach(function (fn) { fn(data); }); }

return { on, emit };
};
__def["js/features/checkout.js"] = function () {
/* =========================================================
   Form pesanan: jam ambil, validasi nama & HP, konfirmasi, link WhatsApp.
   ========================================================= */
const { MENU_WA } = __req("js/config/constants.js");
const { playSuccessSound, playWav, unlockAudio } = __req("js/core/audio.js");
const { emit } = __req("js/core/events.js");
const { toast } = __req("js/core/toast.js");
const { HOURS } = __req("js/data/hours.js");
const { cartLines, cartTotal } = __req("js/state/cart.js");
const { discountFor, getMember, getSettings, normPhone, tierOf } = __req("js/state/members.js");
const { addOrder } = __req("js/state/orders.js");
const { state } = __req("js/state/store.js");
const { $, $all } = __req("js/utils/dom.js");
const { clock, rupiah } = __req("js/utils/format.js");
const { save } = __req("js/utils/storage.js");

/* ---------- Jam ambil ---------- */
function buildSlots() {
  var now = new Date();
  var slots = [];
  var d = new Date(now.getTime() + 15 * 60000);
  d.setMinutes(Math.ceil(d.getMinutes() / 15) * 15, 0, 0);
  var guard = 0;
  while (slots.length < 8 && guard < 400) {
    guard++;
    var h = HOURS[d.getDay()];
    var mins = d.getHours() * 60 + d.getMinutes();
    if (mins >= h.open * 60 && mins <= h.close * 60 - 15) {
      var isToday = d.toDateString() === now.toDateString();
      slots.push({ value: d.toISOString(), label: (isToday ? "" : "Besok ") + clock(d) });
    }
    d = new Date(d.getTime() + 15 * 60000);
  }
  if (slots.length && slots[0].label.indexOf("Besok") === -1 && new Date(slots[0].value) - now < 35 * 60000) {
    slots[0].label = "Secepatnya · " + slots[0].label;
  }
  return slots;
}

function renderSlots() {
  var slots = buildSlots();
  if (!state.selectedSlot || !slots.some(function (s) { return s.value === state.selectedSlot.value; })) state.selectedSlot = slots[0] || null;
  $("#slots").innerHTML = slots.map(function (s) {
    return '<button type="button" class="slot" data-slot="' + s.value + '" data-label="' + s.label + '" aria-pressed="' + (state.selectedSlot && s.value === state.selectedSlot.value) + '">' + s.label + '</button>';
  }).join("");
}

/* ---------- Diskon member (berdasarkan nomor HP) ---------- */
var disc = { pct: 0, tier: "" };
var discPhone = "";

function discountAmount() { return Math.floor(cartTotal() * disc.pct / 100); }

async function lookupDiscount() {
  var p = normPhone($("#phone").value);
  if (p === discPhone) return;
  discPhone = p;
  disc = { pct: 0, tier: "" };
  if (/^08[0-9]{8,11}$/.test(p)) {
    try {
      var m = await getMember(p), st = await getSettings();
      if (p !== discPhone) return;
      var pct = discountFor(m, st);
      if (pct > 0) disc = { pct: pct, tier: tierOf(m, st).name };
    } catch (e) { /* offline: tanpa diskon */ }
  }
  updateWaLink();
}

function paintDiscount() {
  var el = $("#discountLine");
  if (!el) return;
  var d = discountAmount();
  el.hidden = !(disc.pct > 0 && d > 0);
  if (!el.hidden) el.innerHTML = "Diskon member " + disc.tier + " " + disc.pct + "%: <b>−" + rupiah(d) + "</b> · Bayar <b>" + rupiah(cartTotal() - d) + "</b>";
}

function updateWaLink() {
  paintDiscount();
  var lines = cartLines().map(function (l) { return "- " + l.qty + "x " + l.item.name + " (" + rupiah(l.item.price * l.qty) + ")"; });
  var text = "Halo Nuvella Caffe, saya ingin pesan:\n" + lines.join("\n") +
    (disc.pct > 0 ? "\nDiskon member " + disc.tier + " " + disc.pct + "%: -" + rupiah(discountAmount()) : "") +
    "\nTotal: " + rupiah(cartTotal() - discountAmount()) +
    "\nNama: " + ($("#name").value.trim() || "-") +
    "\nNo. HP: " + ($("#phone").value.trim() || "-") +
    (mode() === "delivery" ? "\nDiantar via " + $("#courier").value + "\nAlamat: " + ($("#address").value.trim() || "-") : "") +
    "\nJam " + (mode() === "delivery" ? "siap" : "ambil") + ": " + (state.selectedSlot ? state.selectedSlot.label : "-") +
    ($("#note").value.trim() ? "\nCatatan: " + $("#note").value.trim() : "");
  $("#waOrder").href = "https://wa.me/" + MENU_WA + "?text=" + encodeURIComponent(text);
}

/* Validasi nomor HP: hanya angka */
function validatePhone(showEmpty) {
  var input = $("#phone");
  var v = input.value.trim();
  var title = "", fix = "";
  if (!v) {
    if (showEmpty) { title = "Nomor HP belum diisi."; fix = "Ketik nomor HP aktif yang hanya berisi angka, contoh: 085755183802."; }
  } else if (/[^0-9]/.test(v)) {
    title = "Nomor HP hanya boleh berisi angka.";
    fix = "Cara memperbaiki: hapus huruf, spasi, atau simbol (seperti + - ( ) .) lalu tulis angkanya saja. Contoh: ubah +62 857-5518-3802 menjadi 085755183802.";
  } else if (v.length < 10 || v.length > 13) {
    title = v.length < 10 ? "Nomor HP terlalu pendek." : "Nomor HP terlalu panjang.";
    fix = "Cara memperbaiki: nomor HP Indonesia berisi 10–13 angka dan diawali 08. Sekarang ada " + v.length + " angka.";
  } else if (v.indexOf("08") !== 0) {
    title = "Nomor HP harus diawali 08.";
    fix = "Cara memperbaiki: jika diawali 62, ganti 62 dengan 0. Contoh: 6285755183802 menjadi 085755183802.";
  }
  var box = $("#phoneError");
  if (title) {
    $("#phoneErrorTitle").textContent = title;
    $("#phoneErrorFix").textContent = fix;
    box.hidden = false;
    input.setAttribute("aria-invalid", "true");
    $("#phoneHint").hidden = true;
    return false;
  }
  box.hidden = true;
  input.removeAttribute("aria-invalid");
  $("#phoneHint").hidden = false;
  return !!v;
}

function mode() { var r = document.querySelector('input[name="mode"]:checked'); return r ? r.value : "pickup"; }
function validateAddress(show) {
  var ok = mode() !== "delivery" || $("#address").value.trim().length >= 10;
  $("#addressError").hidden = ok || !show;
  return ok;
}

function validateName(show) {
  var ok = $("#name").value.trim().length >= 2;
  var err = $("#nameError");
  if (!ok && show) { err.textContent = "Isi nama minimal 2 huruf agar barista bisa memanggilmu."; err.hidden = false; $("#name").setAttribute("aria-invalid", "true"); }
  if (ok) { err.hidden = true; $("#name").removeAttribute("aria-invalid"); }
  return ok;
}

function initCheckout() {
  $("#slots").addEventListener("click", function (e) {
    var b = e.target.closest("[data-slot]");
    if (!b) return;
    state.selectedSlot = { value: b.getAttribute("data-slot"), label: b.getAttribute("data-label") };
    $all(".slot").forEach(function (s) { s.setAttribute("aria-pressed", s === b); });
    $("#slotError").hidden = true;
    updateWaLink();
  });

  document.querySelectorAll('input[name="mode"]').forEach(function (r) {
    r.addEventListener("change", function () { $("#deliveryBox").hidden = mode() !== "delivery"; validateAddress(false); updateWaLink(); });
  });
  ["#address", "#courier"].forEach(function (s) { $(s).addEventListener("input", updateWaLink); });

  ["#name", "#phone", "#note"].forEach(function (s) { $(s).addEventListener("input", updateWaLink); });

  $("#phone").addEventListener("input", function () { validatePhone(false); lookupDiscount(); });
  $("#phone").addEventListener("blur", function () { if ($("#phone").value) validatePhone(true); });
  $("#name").addEventListener("input", function () { validateName(false); });

  $("#orderForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var okName = validateName(true);
    var okPhone = validatePhone(true);
    var okSlot = !!state.selectedSlot;
    var okAddr = validateAddress(true);
    $("#slotError").hidden = okSlot;
    if (!okName) { $("#name").focus(); return; }
    if (!okPhone) { $("#phone").focus(); return; }
    if (!okAddr) { $("#address").focus(); return; }
    if (!okSlot) return;

    unlockAudio();
    var btn = $("#submitOrder");
    btn.classList.add("is-loading");
    btn.disabled = true;
    setTimeout(async function () {
      await lookupDiscount();
      var sub = cartTotal(), potong = discountAmount();
      state.order = {
        code: "NV-" + Math.floor(1000 + Math.random() * 9000),
        name: $("#name").value.trim(),
        phone: $("#phone").value.trim(),
        pickup: state.selectedSlot.label.replace("Secepatnya · ", ""),
        lines: cartLines().map(function (l) { return { name: l.item.name, qty: l.qty, price: l.item.price }; }),
        subtotal: sub,
        discount: potong,
        discountPct: potong ? disc.pct : 0,
        tier: potong ? disc.tier : "",
        total: sub - potong,
        note: $("#note").value.trim(),
        delivery: mode() === "delivery" ? { courier: $("#courier").value, address: $("#address").value.trim() } : null,
        ship: 0,
        createdAt: Date.now(),
        status: 0,
        done: false
      };
      save("nuvella_order", state.order);
      addOrder(state.order).catch(function () { toast("Pesanan tersimpan di perangkatmu, tapi belum terkirim ke admin. Gunakan tombol WhatsApp."); });
      state.cart = {}; save("nuvella_cart", state.cart);
      btn.classList.remove("is-loading");
      btn.disabled = false;
      $("#orderForm").reset();
      $("#deliveryBox").hidden = true;
      state.selectedSlot = null;
      $("#slots").innerHTML = "";
      emit("cart:changed");
      playWav(playSuccessSound);
      toast("Pesanan " + state.order.code + " berhasil dibuat");
      window.scrollTo(0, 0);
    }, 900);
  });
}

return { renderSlots, updateWaLink, initCheckout };
};
__def["js/core/audio.js"] = function () {
/* =========================================================
   Semua suara: file .wav, bunyi sukses, pop, klik, dan salam maskot (Web Audio).
   ========================================================= */
const { SFX_FILE } = __req("js/config/constants.js");

/* ---------- Suara sukses pesanan (Web Audio, tanpa file) ---------- */
let audioCtx = null;
function unlockAudio() {
  try {
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    if (!audioCtx) audioCtx = new AC();
    if (audioCtx.state === "suspended") audioCtx.resume();
  } catch (e) {}
}
/* Suara file .wav (taruh file di folder yang sama dengan index.html). Jika file tidak ada, pakai suara bawaan. */
var sfxEl = null;
function playWav(fallback) {
  try {
    if (!sfxEl) { sfxEl = new Audio(SFX_FILE); sfxEl.preload = "auto"; }
    sfxEl.currentTime = 0;
    var p = sfxEl.play();
    if (p && p.catch) p.catch(function () { if (fallback) fallback(); });
  } catch (e) { if (fallback) fallback(); }
}
function playSuccessSound() {
  try {
    unlockAudio();
    var ctx = audioCtx;
    if (!ctx) return;
    var t0 = ctx.currentTime + 0.05;
    var master = ctx.createGain();
    master.gain.value = 0.5;
    master.connect(ctx.destination);
    /* gema lembut */
    var delay = ctx.createDelay(); delay.delayTime.value = 0.24;
    var fb = ctx.createGain(); fb.gain.value = 0.32;
    var wet = ctx.createGain(); wet.gain.value = 0.35;
    delay.connect(fb); fb.connect(delay); delay.connect(wet); wet.connect(master);
    function bell(freq, start, dur, vol) {
      [[1, 1], [2.01, 0.35], [2.76, 0.18], [5.4, 0.07]].forEach(function (p) {
        var o = ctx.createOscillator(), g = ctx.createGain();
        o.type = "sine"; o.frequency.value = freq * p[0];
        g.gain.setValueAtTime(0.0001, t0 + start);
        g.gain.exponentialRampToValueAtTime(vol * p[1], t0 + start + 0.012);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + start + dur / p[0] * (p[0] > 1 ? 1.4 : 1));
        o.connect(g); g.connect(master); g.connect(delay);
        o.start(t0 + start); o.stop(t0 + start + dur + 0.2);
      });
    }
    /* arpeggio naik C mayor 7: ting-ting-ting-TING */
    bell(659.25, 0.00, 1.1, 0.22);   // E5
    bell(783.99, 0.11, 1.1, 0.22);   // G5
    bell(987.77, 0.22, 1.2, 0.22);   // B5
    bell(1318.5, 0.36, 1.8, 0.28);   // E6
    bell(2093.0, 0.52, 1.4, 0.10);   // C7 kilau
  } catch (e) {}
}

/* ---------- Suara maskot & tombol Klik (Web Audio, tanpa file) ---------- */
function tone(freq, start, dur, vol, type, slideTo) {
  var ctx = audioCtx; if (!ctx) return;
  var t0 = ctx.currentTime + 0.02 + start;
  var o = ctx.createOscillator(), g = ctx.createGain();
  o.type = type || "sine";
  o.frequency.setValueAtTime(freq, t0);
  if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t0 + dur * 0.8);
  g.gain.setValueAtTime(0.0001, t0);
  g.gain.exponentialRampToValueAtTime(vol, t0 + 0.012);
  g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
  o.connect(g); g.connect(ctx.destination);
  o.start(t0); o.stop(t0 + dur + 0.05);
}
/* Suara kartun: nada bergetar (vibrato) yang meluncur naik/turun, seperti "boing" */
function toon(freq, start, dur, vol, slideTo, wobble) {
  var ctx = audioCtx; if (!ctx) return;
  var t0 = ctx.currentTime + 0.02 + start;
  var o = ctx.createOscillator(), g = ctx.createGain();
  o.type = "triangle";
  o.frequency.setValueAtTime(freq, t0);
  if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t0 + dur * 0.85);
  if (wobble) {
    var lfo = ctx.createOscillator(), lg = ctx.createGain();
    lfo.frequency.value = wobble; lg.gain.value = freq * 0.06;
    lfo.connect(lg); lg.connect(o.frequency);
    lfo.start(t0); lfo.stop(t0 + dur + 0.05);
  }
  g.gain.setValueAtTime(0.0001, t0);
  g.gain.exponentialRampToValueAtTime(vol, t0 + 0.015);
  g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
  o.connect(g); g.connect(ctx.destination);
  o.start(t0); o.stop(t0 + dur + 0.05);
}
function playPop() {
  try {
    unlockAudio(); if (!audioCtx) return;
    toon(260, 0, 0.22, 0.26, 820, 22);      // boing!
    toon(1100, 0.16, 0.12, 0.14, 1500, 0);  // cit!
  } catch (e) {}
}
function playKlik() {
  try {
    unlockAudio(); if (!audioCtx) return;
    tone(880, 0, 0.09, 0.16, "square", 660);
    tone(1318.5, 0.07, 0.5, 0.2, "sine");
    tone(1760, 0.15, 0.55, 0.16, "sine");
    tone(2637, 0.24, 0.7, 0.08, "sine");
  } catch (e) {}
}

/* Salam maskot: suara kartun "boing, hehe, wiii" (tanpa suara robot/AI) */
/* Salam maskot: suara "Selamat datang di Nuvella Cafe", diulang tiap maskot ditekan */
function playWelcome() {
  try {
    if ("speechSynthesis" in window && window.SpeechSynthesisUtterance) {
      var synth = window.speechSynthesis;
      synth.cancel();
      var u = new SpeechSynthesisUtterance("Selamat datang di Nuvella Cafe");
      u.lang = "id-ID"; u.pitch = 1.4; u.rate = 0.95; u.volume = 1;
      var v = synth.getVoices().filter(function (x) { return /^id/i.test(x.lang); })[0];
      if (v) u.voice = v;
      synth.speak(u);
      return;
    }
  } catch (e) {}
  playWelcomeTones();
}

function playWelcomeTones() {
  try {
    unlockAudio(); if (!audioCtx) return;
    toon(220, 0, 0.28, 0.28, 760, 24);       // boing
    toon(900, 0.30, 0.10, 0.2, 1250, 0);     // he
    toon(980, 0.42, 0.10, 0.2, 1350, 0);     // he
    toon(1050, 0.54, 0.10, 0.2, 1450, 0);    // he
    toon(500, 0.70, 0.45, 0.22, 1500, 16);   // wiii~
  } catch (e) {}
}

return { audioCtx, unlockAudio, playWav, playSuccessSound, playPop, playKlik, playWelcome };
};
__def["js/data/hours.js"] = function () {
/* =========================================================
   Jam operasional (indeks 0 = Minggu).
   ========================================================= */

/* Jam operasional — indeks 0 = Minggu */
const HOURS = [
  { day: "Minggu", open: 8, close: 23 },
  { day: "Senin", open: 7, close: 22 },
  { day: "Selasa", open: 7, close: 22 },
  { day: "Rabu", open: 7, close: 22 },
  { day: "Kamis", open: 7, close: 22 },
  { day: "Jumat", open: 7, close: 22 },
  { day: "Sabtu", open: 8, close: 23 }
];

return { HOURS };
};
__def["js/state/cart.js"] = function () {
/* =========================================================
   Hitungan isi keranjang (tanpa DOM).
   ========================================================= */
const { findItem } = __req("js/data/menu.js");
const { state } = __req("js/state/store.js");

function cartLines() {
  return Object.keys(state.cart).map(function (id) { return { item: findItem(id), qty: state.cart[id] }; }).filter(function (l) { return l.item && l.qty > 0; });
}
function cartTotal() { return cartLines().reduce(function (s, l) { return s + l.item.price * l.qty; }, 0); }
function cartCount() { return cartLines().reduce(function (s, l) { return s + l.qty; }, 0); }

return { cartLines, cartTotal, cartCount };
};
__def["js/data/menu.js"] = function () {
/* =========================================================
   Data menu, kategori, dan urutan foto cadangan.
   ========================================================= */
const { FOTO_DIR } = __req("js/config/constants.js");

const CATEGORIES = [
  { id: "signature", name: "Signature" },
  { id: "cheesecake", name: "Cheesecake" },
  { id: "mille-crepe", name: "Mille Crepe" },
  { id: "pastry", name: "Pastry" },
  { id: "coffe", name: "Coffe" },
  { id: "non-coffe", name: "Non Coffe" }
];

/* fx = jenis animasi pada gambar: pistachio | choco | steam | bubble | sparkle */
const MENU = [
  { id: "ice-cream-brownies", cat: "signature", fx: "steam", name: "Ice Cream Brownies", desc: "Brownies hangat dengan satu scoop vanilla", price: 20000,
    img: "https://commons.wikimedia.org/wiki/Special:FilePath/Brownie_with_Vanilla_Ice_cream.jpg?width=400" },
