    pl("tl", tx, 95, tz, 8, 70, "");
    pl("tl", tx, 95, tz, 8, 70, "rotateY(90deg)");
    pl("te", tx, 62, tz, 84, 84, "rotateX(90deg)");
    pl("tt", tx, 59, tz, 84, 84, "rotateX(90deg)");
    pl("cup", tx + 10, 53, tz + 4, 14, 12, "", '<b class="stm" style="position:absolute;left:2px;top:-24px;width:10px;height:22px"></b>');
    chair(tx, tz - 58, 1);
    chair(tx, tz + 58, -1);
  }
  [-270, -455, -640].forEach(function (z) { table(-235, z); table(235, z); });

  /* lampu gantung & genangan cahaya */
  function lamp(x, z) {
    pl("cord", x, -135, z, 2, 70, "");
    pl("shade", x, -98, z, 36, 22, "");
    pl("glow", x, -84, z, 100, 100, "");
    pl("pool", x, FL - 1.2, z, 280, 280, "rotateX(90deg)");
  }
  [-270, -455, -640].forEach(function (z) { lamp(-235, z); lamp(235, z); });
  lamp(0, -220); lamp(0, -470); lamp(-110, -700); lamp(110, -700);

  cam.innerHTML = o.join("");

  /* jeda animasi saat kedai di luar layar */
  var scene = $("#shop3d");
  if (scene && "IntersectionObserver" in window) {
    new IntersectionObserver(function (en) {
      scene.classList.toggle("is-off", !en[0].isIntersecting);
    }).observe(scene);
  }
}

var cafeTimer = 0;
function restartCafe() {
  var s = $("#shop3d");
  if (!s) return;
  /* mulai tur setelah transisi halaman selesai, supaya tidak berebut dengan animasinya */
  clearTimeout(cafeTimer);
  s.classList.remove("run");
  cafeTimer = setTimeout(function () { s.classList.add("run"); }, 700);
}

return { buildCafe, restartCafe };
};
__def["js/effects/image-fx.js"] = function () {
/* =========================================================
   Efek animasi di atas foto menu (uap, taburan, gelembung, kilau).
   ========================================================= */
const { $all } = __req("js/utils/dom.js");

/* ---------- Efek animasi pada gambar (taburan, uap, gelembung, kilau) ---------- */
var FX_COUNT = { pistachio: 0, choco: 0, steam: 4, bubble: 9, sparkle: 7 };
var FX_COLORS = {
  pistachio: ["#7a9a3c", "#a3c15a", "#5d7a2e", "#c4d98a"],
  choco: ["#4a2c1a", "#6b3f26", "#2f1a0f"]
};

function fxHTML(type, big) {
  var n = FX_COUNT[type];
  if (!n) return "";
  var html = '<div class="fx fx--' + type + (big ? " fx--big" : "") + '" aria-hidden="true">';
  for (var i = 0; i < n; i++) {
    var x = type === "steam" ? (big ? 36 + i * 12 : 32 + i * 16) : Math.round(6 + (88 / n) * i + (i % 2) * 5);
    var y = 8 + ((i * 37) % 70);
    var d = ((i * 0.43) % 2.6).toFixed(2);
    var s = (type === "steam" ? 2.4 : 1.8 + (i % 3) * 0.5).toFixed(1);
    var colors = FX_COLORS[type];
    var c = colors ? colors[i % colors.length] : "#fff";
    html += '<i style="--x:' + x + '%;--y:' + y + '%;--d:' + d + 's;--s:' + s + 's;--c:' + c + '"></i>';
  }
  return html + "</div>";
}

function mountHeroFx() {
  $all("[data-fx]").forEach(function (el) {
    el.outerHTML = fxHTML(el.getAttribute("data-fx"), el.hasAttribute("data-big"));
  });
}

return { mountHeroFx };
};
__def["js/effects/pointer.js"] = function () {
/* =========================================================
   Efek yang mengikuti kursor/sentuhan: putar kedai 3D, tilt kartu, parallax.
   ========================================================= */
const { $ } = __req("js/utils/dom.js");
const { REDUCE } = __req("js/utils/env.js");

/* Kedai 3D: putar mengikuti kursor / sentuhan */
function initShopPointer() {
  var scene = $("#shop3d");
  if (!scene) return;
  var look = scene.querySelector(".cafe__look");
  var raf = 0, nx = 0, ny = 0;
  function apply() {
    raf = 0;
    /* diatur langsung di satu elemen (bukan variabel CSS yang diwarisi ratusan elemen) */
    if (look) look.style.transform = "rotateX(" + (ny * -3).toFixed(2) + "deg) rotateY(" + (nx * 6).toFixed(2) + "deg)";
  }
  function set(x, y) { nx = x; ny = y; if (!raf) raf = requestAnimationFrame(apply); }
  scene.addEventListener("pointermove", function (e) {
    if (REDUCE) return;
    var r = scene.getBoundingClientRect();
    set(((e.clientX - r.left) / r.width - 0.5) * 2, ((e.clientY - r.top) / r.height - 0.5) * 2);
  });
  scene.addEventListener("pointerleave", function () { set(0, 0); });
}

var TILT_SEL = ".menu-item, .pillar-card, .stat-box, .steps li";
var tiltEl = null;
function resetTilt(el) {
  if (!el) return;
  ["--rx", "--ry", "--mx", "--my"].forEach(function (p) { el.style.removeProperty(p); });
}

function initTilt() {
  document.addEventListener("pointermove", function (e) {
    if (REDUCE || e.pointerType === "touch") return;
    var el = e.target.closest ? e.target.closest(TILT_SEL) : null;
    if (tiltEl && tiltEl !== el) resetTilt(tiltEl);
    tiltEl = el;
    if (!el) return;
    var r = el.getBoundingClientRect();
    var px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
    el.style.setProperty("--ry", ((px - 0.5) * 14).toFixed(2) + "deg");
    el.style.setProperty("--rx", ((0.5 - py) * 14).toFixed(2) + "deg");
    el.style.setProperty("--mx", (px * 100).toFixed(0) + "%");
    el.style.setProperty("--my", (py * 100).toFixed(0) + "%");
  });
  document.addEventListener("mouseleave", function () { resetTilt(tiltEl); tiltEl = null; });
}

function initHeroParallax() {
  var hero = $(".hero"), tilt = $(".hero__tilt");
  if (!hero || !tilt) return;
  hero.addEventListener("pointermove", function (e) {
    if (REDUCE || e.pointerType === "touch") return;
    var r = hero.getBoundingClientRect();
    tilt.style.setProperty("--px", (((e.clientX - r.left) / r.width - 0.5) * 2).toFixed(3));
    tilt.style.setProperty("--py", (((e.clientY - r.top) / r.height - 0.5) * 2).toFixed(3));
  });
  hero.addEventListener("pointerleave", function () {
    tilt.style.setProperty("--px", 0); tilt.style.setProperty("--py", 0);
  });
}

return { initShopPointer, initTilt, initHeroParallax };
};
__def["js/effects/reveal.js"] = function () {
/* =========================================================
   Judul per kata dan kartu yang muncul saat di-scroll.
   ========================================================= */
const { $all } = __req("js/utils/dom.js");
const { REDUCE } = __req("js/utils/env.js");

function splitWords() {
  $all(".display, .page-title").forEach(function (h) {
    var k = 0;
    Array.prototype.slice.call(h.childNodes).forEach(function (n) {
      if (n.nodeType !== 3) return;
      var frag = document.createDocumentFragment();
      n.textContent.split(/(\s+)/).forEach(function (part) {
        if (!part) return;
        if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(" ")); return; }
        var s = document.createElement("span");
        s.className = "w"; s.style.setProperty("--k", k++); s.textContent = part;
        frag.appendChild(s);
      });
      h.replaceChild(frag, n);
    });
  });
}

function initReveal() {
  if (REDUCE || !("IntersectionObserver" in window)) return;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) {
      if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); }
    });
  }, { threshold: 0.15 });
  $all(".steps li, .pillar-card, .stat-box").forEach(function (el, i) {
    el.classList.add("reveal");
    el.style.setProperty("--rd", (i % 4) * 90 + "ms");
    io.observe(el);
  });
}

return { splitWords, initReveal };
};
__def["js/effects/kelas-anim.js"] = function () {
/* =========================================================
   Animasi Kelas Kreasi Kue (beranda): bergerak saat dipencet.
   Dipicu dengan menyentuh gambar animasinya atau tombol pendaftaran.
   ========================================================= */
function initKelasAnim() {
  var anim = document.getElementById("kelasAnim");
  var card = document.getElementById("kelasKue");
  if (!anim || !card) return;
  var timer = 0;
  function pop() {
    anim.classList.remove("is-pop");
    void anim.offsetWidth; /* mulai ulang animasi kalau dipencet berulang */
    anim.classList.add("is-pop");
    clearTimeout(timer);
    timer = setTimeout(function () { anim.classList.remove("is-pop"); }, 950);
  }
  anim.addEventListener("click", pop);
  var btn = card.querySelector(".btn");
  if (btn) btn.addEventListener("click", pop);
}

return { initKelasAnim };
};
__def["js/features/admin.js"] = function () {
/* =========================================================
   Halaman Admin (#/admin): login, daftar pesanan pelanggan, ubah status, hapus.
   ========================================================= */
const { ADMIN_EMAIL, ADMIN_PASS_HASH, MEMBER_PRICE, MEMBER_RENEW_PRICE, MEMBER_REWARD_MONTHS, MEMBER_TARGET } = __req("js/config/constants.js");
const { onRoute } = __req("js/core/router.js");
const { toast } = __req("js/core/toast.js");
const { addFinance, listFinance, removeFinance } = __req("js/state/finance.js");
const { activate, addSpend, bungaRate, confirmRedeem, creditCycleBunga, expiryDate, getMember, getSettings, giveStamp, isExpired, listMembers, normPhone, removeMember, saveMember, saveSettings, spendBunga, takeStamp, tierOf } = __req("js/state/members.js");
const { listOrders, patchOrder, removeOrder } = __req("js/state/orders.js");
const { $, $all, esc } = __req("js/utils/dom.js");
const { rupiah } = __req("js/utils/format.js");

var SESSION_KEY = "nuvella_admin";
var STAGES = ["Menunggu", "Sedang dibuat", "Siap diambil", "Selesai"];
var filter = "all";
var orders = [];
var knownCodes = null;
var timer = null;
var failCount = 0;
var members = [];
var tab = "orders";
var ratingFilter = "all";
var finance = [];
var settings = null;
var finYear = new Date().getFullYear();
var finMonth = new Date().getMonth();
var MONTHS = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
var PRESETS = {
  d3: { title: "Potongan harga 3%", desc: "Berlaku untuk 1 transaksi." },
  combo: { title: "Minuman & makanan spesial", desc: "1 minuman dan 1 makanan pilihan barista." },
  pastry: { title: "1 Pastry", desc: "Pilih 1 pastry dari etalase." },
  cone: { title: "Es krim cone", desc: "1 es krim cone gratis." }
};

function loggedIn() { try { return sessionStorage.getItem(SESSION_KEY) === "1"; } catch (e) { return false; } }
function setLoggedIn(on) { try { on ? sessionStorage.setItem(SESSION_KEY, "1") : sessionStorage.removeItem(SESSION_KEY); } catch (e) {} }

async function sha256(text) {
  var buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
  return Array.from(new Uint8Array(buf)).map(function (b) { return b.toString(16).padStart(2, "0"); }).join("");
}

function waLink(phone) { return "https://wa.me/" + String(phone).replace(/^0/, "62"); }
function when(ts) {
  return new Date(ts).toLocaleString("id-ID", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
}

function paintFilters() {
  var tabs = [{ id: "all", name: "Semua", n: orders.length }].concat(STAGES.map(function (name, i) {
    return { id: String(i), name: name, n: orders.filter(function (o) { return (o.status || 0) === i; }).length };
  }));
  $("#adminFilters").innerHTML = tabs.map(function (t) {
    return '<button type="button" class="tab" data-filter="' + t.id + '" aria-selected="' + (t.id === filter) + '">' + t.name + ' (' + t.n + ')</button>';
  }).join("");
}

function memberByPhone(phone) {
  var p = normPhone(phone);
  return members.filter(function (m) { return m.phone === p; })[0] || null;
}

function stampLine(o) {
  var m = memberByPhone(o.phone), st = o.status || 0;
  if (o.stamped) return '<p><b>Stempel</b>✓ sudah diberikan</p>';
  if (!m) return "";
  if (!m.active) return '<p><b>Member</b>Kartu belum diaktifkan</p>';
  if (st === 3) return '<p><b>Stempel</b><button type="button" class="adm-link" data-stamp="' + esc(o.code) + '">Beri stempel member</button></p>';
  return '<p><b>Member</b>Stempel otomatis saat status Selesai</p>';
}

var SHIP = ["Mencari driver", "Driver menuju kafe", "Sedang diantar", "Pesanan tiba"];

function deliveryBlock(o) {
  if (!o.delivery) return "";
  var ship = o.ship || 0, a = o.delivery.address;
  var btns = SHIP.map(function (name, i) {
    return '<button type="button" class="btn btn--secondary adm-stage" data-ship="' + i + '" data-code="' + esc(o.code) + '" aria-pressed="' + (i === ship) + '">' + name + '</button>';
  }).join("");
  var app = o.delivery.courier === "Grab" ? "https://www.grab.com/id/" : "https://www.gojek.com/";
  return '<div class="adm-ship"><p><b>Antar</b> ' + esc(o.delivery.courier) + '</p><p><b>Alamat</b> ' + esc(a) + '</p>' +
    '<p><a href="https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(a) + '" target="_blank" rel="noopener">Buka di Maps</a> · <a href="' + app + '" target="_blank" rel="noopener">Buka ' + esc(o.delivery.courier) + '</a> · <button type="button" class="adm-link" data-copy="' + esc(a) + '">Salin alamat</button></p>' +
    '<div class="adm-stages" role="group" aria-label="Status pengantaran ' + esc(o.code) + '">' + btns + '</div></div>';
}

function card(o) {
