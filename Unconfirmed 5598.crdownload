__def["js/effects/flowers.js"] = function () {
/* =========================================================
   SVG bunga & biji kopi (dipakai maskot, intro, dan hujan kue).
   ========================================================= */

function flowerSVG(petal, center, n) {
  n = n || 5;
  var s = '<svg viewBox="0 0 40 40" aria-hidden="true">';
  for (var i = 0; i < n; i++) {
    s += '<ellipse cx="20" cy="10" rx="6.5" ry="9" fill="' + petal + '" transform="rotate(' + (360 / n * i) + ' 20 20)"/>';
  }
  return s + '<circle cx="20" cy="20" r="5.6" fill="' + center + '"/><circle cx="18.4" cy="18.4" r="1.7" fill="#fff" opacity="0.65"/></svg>';
}
function beanSVG() {
  return '<svg viewBox="0 0 24 24" aria-hidden="true"><g transform="rotate(30 12 12)"><ellipse cx="12" cy="12" rx="6.5" ry="10" fill="#6b3f26"/><path d="M12 2.5C9 8 15 16 12 21.5" fill="none" stroke="#3a1c0e" stroke-width="1.6" stroke-linecap="round"/></g></svg>';
}
const FLOWER_COLORS = [
  ["#fff4e6", "#b9824a"], ["#f1d4a8", "#6b3f26"], ["#e0b47a", "#3d2a1f"],
  ["#c98f50", "#fff4e6"], ["#fbe9c7", "#8a5a3c"], ["#d9a466", "#4a2c1a"], ["#f6e0b8", "#a9784f"]
];

return { flowerSVG, beanSVG, FLOWER_COLORS };
};
__def["js/utils/format.js"] = function () {
/* =========================================================
   Format angka, waktu, dan angka acak.
   ========================================================= */

function rupiah(n) { return "Rp" + n.toLocaleString("id-ID"); }
function short(n) { return n / 1000 + "k"; }
function pad(n) { return (n < 10 ? "0" : "") + n; }
function clock(d) { return pad(d.getHours()) + "." + pad(d.getMinutes()); }

function rnd(a, b) { return a + Math.random() * (b - a); }

return { rupiah, short, pad, clock, rnd };
};
__def["js/effects/cafe-3d.js"] = function () {
/* =========================================================
   Kedai 3D (CSS) untuk halaman Tentang Kami.
   ========================================================= */
const { $ } = __req("js/utils/dom.js");

/* ---------- Kedai realistis: tur masuk kafe (3D CSS, tanpa gambar kartun) ---------- */
function buildCafe() {
  var cam = $("#cafeCam");
  if (!cam) return;
  var o = [];
  function pl(cls, cx, cy, cz, w, hh, rot, inner, st) {
    o.push('<div class="p ' + cls + '" style="width:' + w + 'px;height:' + hh + 'px;left:' + (-w / 2) + 'px;top:' + (-hh / 2) + 'px;transform:translate3d(' + cx + 'px,' + cy + 'px,' + cz + 'px) ' + (rot || "") + ";" + (st || "") + '">' + (inner || "") + "</div>");
  }
  function fc(k, cls, w, hh, tr) {
    return '<i class="fc fc-' + k + " " + cls + '" style="width:' + w + "px;height:" + hh + "px;left:" + (-w / 2) + "px;top:" + (-hh / 2) + "px;transform:" + tr + '"></i>';
  }
  function box(cls, cx, cy, cz, w, hh, d, topCls) {
    o.push('<div class="bx" style="transform:translate3d(' + cx + "px," + cy + "px," + cz + 'px)">' +
      fc("f", cls, w, hh, "translateZ(" + d / 2 + "px)") +
      fc("b", cls, w, hh, "rotateY(180deg) translateZ(" + d / 2 + "px)") +
      fc("s", cls, d, hh, "rotateY(90deg) translateZ(" + w / 2 + "px)") +
      fc("s2", cls, d, hh, "rotateY(-90deg) translateZ(" + w / 2 + "px)") +
