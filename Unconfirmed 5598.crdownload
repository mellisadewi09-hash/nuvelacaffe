function ckBuildMessage() {
  var sz = ckFind(CK.sizes, ck.size), sh = ckFind(CK.shapes, ck.shape), sp = ckFind(CK.sponges, ck.sponge), spr = ckFind(CK.sprinkles, ck.sprinkle);
