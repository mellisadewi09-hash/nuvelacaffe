const { load } = __req("js/utils/storage.js");

const state = {
  cart: load("nuvella_cart", {}),
  order: load("nuvella_order", null),
  activeCat: "signature",
  selectedSlot: null,
  statusTimer: null,
  leaveTimer: null,
